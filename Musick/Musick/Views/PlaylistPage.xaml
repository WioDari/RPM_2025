<Page x:Class="Musick.Views.PlaylistPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Musick.Views"
      xmlns:n ="clr-namespace:Musick.Views.UserControls"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PlaylistPage">

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="59*"/>
            <RowDefinition Height="391*"/>
        </Grid.RowDefinitions>

        <ListBox ItemsSource="{Binding playlists}" SelectedItem="{Binding SelectedPlaylist}" Grid.Row="1">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="#FF7A00CC" BorderThickness="2" CornerRadius="3">
                        <n:PlaylistItem/>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Button Content="Создать" Style="{StaticResource ButtonStyleGeneral}"  HorizontalAlignment="Left" Margin="715,0,0,0" VerticalAlignment="Center" Height="39" Width="75" FontSize="14">
            <Button.Background>
                <RadialGradientBrush>
                    <GradientStop Color="#FF7A00CC" Offset="1"/>
                    <GradientStop Color="White" Offset="0.702"/>
                </RadialGradientBrush>
            </Button.Background>
        </Button>

    </Grid>
</Page>
