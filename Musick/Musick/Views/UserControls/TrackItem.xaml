<UserControl x:Class="Musick.Views.UserControls.TrackItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Musick.Views.UserControls"
             mc:Ignorable="d" d:DesignWidth="800" Height="57"
             Width="800"
             >
    <Grid Background="White">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <StackPanel
            Orientation="Vertical" Margin="0,0,10,0"
            >
            <TextBlock TextWrapping="Wrap" Text="{Binding TrackName}"/>
            <TextBlock  Text="{Binding Artist}" />
        </StackPanel>


        <StackPanel Grid.Column="1" Margin="10,0,10,0">
            
            <TextBlock Grid.Column="1" HorizontalAlignment="Left" TextWrapping="Wrap" Text="{Binding AlbumNameOrCoutntAuditions}" VerticalAlignment="Center" Height="30"/>
        </StackPanel>
        <StackPanel Grid.Column="2" Margin="10,0,10,0">
            <TextBlock Text="Рейтинг"/>
            <TextBlock Grid.Column="1" HorizontalAlignment="Left" TextWrapping="Wrap" Text="{Binding Rating}" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Grid.Column="3" Margin="10,0,10,0">
            <TextBlock Text="Длительность"/>
            <TextBlock Grid.Column="1" HorizontalAlignment="Left" TextWrapping="Wrap" Text="{Binding DurationString}" VerticalAlignment="Center"/>
        </StackPanel>

    </Grid>
</UserControl>
