<UserControl x:Class="Musick.Views.UserControls.AlbumItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Musick.Views.UserControls"
             mc:Ignorable="d" Height="249" Width="187">
    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="83*"/>
            <RowDefinition Height="35*"/>
        </Grid.RowDefinitions>
        <TextBlock HorizontalAlignment="Left" Grid.Row="1" TextWrapping="Wrap" Text="{Binding AlbumName}" VerticalAlignment="Top" Margin="4,4,0,0" FontSize="16" FontFamily="Times New Roman"/>
        <TextBlock HorizontalAlignment="Left" Margin="4,44,0,0" Grid.Row="1" TextWrapping="Wrap" Text="{Binding  ArtistName}" VerticalAlignment="Top"/>
        <TextBlock HorizontalAlignment="Left" Visibility="Collapsed" Margin="4,29,0,0" Grid.Row="1" TextWrapping="Wrap" Text="{Binding  ID}" VerticalAlignment="Top"/>
        <Image HorizontalAlignment="Left" Source="{Binding Photo}" Grid.Row="0" Height="142" VerticalAlignment="Top" Width="147" Margin="18,15,0,0"/>
        <TextBlock HorizontalAlignment="Left" Margin="128,0,0,0" Grid.Row="1" TextWrapping="Wrap" Text="{Binding CountTraks}" VerticalAlignment="Center"/>

    </Grid>
</UserControl>
