<Page x:Class="Musick.Views.TrackPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Musick.Views"
       xmlns:n="clr-namespace:Musick.Views.UserControls"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="TrackPage">

    <Grid Background="White">
        <ListBox ItemsSource="{Binding TracksList}">
        <ListBox.ItemTemplate>
            <DataTemplate>
                    <Border BorderThickness="2" BorderBrush="#FF7A00CC">
                <n:TrackItem/>
                    </Border>
                </DataTemplate>
        </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Page>
