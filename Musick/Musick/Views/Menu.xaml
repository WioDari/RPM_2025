<Window x:Class="Musick.Views.Menu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Musick.Views"
        mc:Ignorable="d"
        Style="{StaticResource GeneralStyle}"
        Title="Menu" Height="450" Width="800">
    <Grid Background="White">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="21*"/>
            <ColumnDefinition Width="59*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="34*"/>
            <RowDefinition Height="183*"/>
        </Grid.RowDefinitions>
        <Border  CornerRadius="8,8,8,8" BorderThickness="1"  BorderBrush="White" Background="#FFEDE2FF">
            <TextBlock TextWrapping="Wrap" Text="{Binding name}" Margin="10, 10, 10 ,10"/>
        </Border>

        <Button Style="{StaticResource ButtonStyleGeneral}" Content="Выход" HorizontalAlignment="Left" Margin="152,36,0,0" VerticalAlignment="Top" Background="#FF7A00CC" Foreground="White"/>


        <Border BorderBrush="White" BorderThickness="1" Grid.Row="1" CornerRadius="8,8,8,8" Background="#FFEDE2FF">
            <TextBlock TextWrapping="Wrap" Text="Меню" HorizontalAlignment="Center" Margin="0,0,0,344"/>
        </Border>
        <Button Style="{StaticResource ButtonStyleGeneral}" Command="{Binding TrackNavigateCommand}" Content="Треки" HorizontalAlignment="Center" Margin="0,37,0,0" Grid.Row="1" VerticalAlignment="Top" Width="190">
            <Button.Background>
                <RadialGradientBrush>
                    <GradientStop Color="#FF7A00CC" Offset="1"/>
                    <GradientStop Color="White" Offset="0.439"/>
                </RadialGradientBrush>
            </Button.Background>
        </Button>
        <Button Style="{StaticResource ButtonStyleGeneral}" Command="{Binding AlbumNavigateCommand}" Content="Альбомы" HorizontalAlignment="Center" Margin="0,84,0,0" Grid.Row="1" VerticalAlignment="Top" Width="190">
            <Button.Background>
                <RadialGradientBrush>
                    <GradientStop Color="#FF7A00CC" Offset="1"/>
                    <GradientStop Color="White" Offset="0.439"/>
                </RadialGradientBrush>
            </Button.Background>
        </Button>
        <Button Style="{StaticResource ButtonStyleGeneral}" Command="{Binding PlaylistNavigateCommand}" Content="Плейлисты" HorizontalAlignment="Center" Margin="0,132,0,0" Grid.Row="1" VerticalAlignment="Top" Width="190">
            <Button.Background>
                <RadialGradientBrush>
                    <GradientStop Color="#FF7A00CC" Offset="1"/>
                    <GradientStop Color="White" Offset="0.439"/>
                </RadialGradientBrush>
            </Button.Background>
        </Button>
        <Image HorizontalAlignment="Left"  Source="/Resources/Flow.png" Height="100" Margin="10,257,0,0" Grid.Row="1" VerticalAlignment="Top" Width="100"/>
        <Image HorizontalAlignment="Left" Source="/Resources/Flow.png" Margin="105,183,0,83" Grid.Row="1" Width="100"/>
        <Image Grid.Column="1"  Source="/Resources/Flow.png" Height="69" Margin="507,0,2,0" VerticalAlignment="Center"/>
        <Frame Grid.Column="1" Content="{Binding currentPage}"  Grid.RowSpan="2" NavigationUIVisibility="Hidden" />









    </Grid>
</Window>
