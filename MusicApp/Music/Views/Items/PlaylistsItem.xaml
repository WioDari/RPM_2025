<UserControl Style="{StaticResource MainUserControlStyle}"
             x:Class="Music.Views.Items.PlaylistsItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Music.Views.Items"
             mc:Ignorable="d" 
             Height="100"  Width="500"
                   d:DesignHeight="100" d:DesignWidth="200" Background="White">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="4*"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Border BorderBrush="Black" BorderThickness="1" Grid.ColumnSpan="2">
            <StackPanel Orientation="Horizontal">
                <TextBlock Margin="10,0,0,0" Text="{Binding name}" FontWeight="Bold" FontSize="12pt"/>
                <TextBlock Margin="10,0,0,0" Text=" |" FontWeight="Bold" FontSize="12pt"/>
                <TextBlock Margin="10,0,0,0" Text="{Binding creatorName}" FontWeight="Bold" FontSize="12pt"/>
            </StackPanel>
        </Border>
        <Border Grid.Row="1" BorderBrush="Black" BorderThickness="1,0,1,0" >
            <TextBlock Margin="12,0,0,0" Text="{Binding likes, StringFormat= Нравится: {0}}"  />
        </Border>
        <Border Grid.Row="2" BorderBrush="Black" BorderThickness="1,0,1,0" >
            <TextBlock Margin="12,0,0,0" Text="Подписчиков: "   />
        </Border>
        <Border Grid.Row="3" BorderBrush="Black" BorderThickness="1,0,1,0" >
            <TextBlock Margin="12,0,0,0" Text="{Binding numberOfTrack, StringFormat= Треков: {0}}"   />
        </Border>
        <Border Grid.Row="4" BorderBrush="Black" BorderThickness="1,0,1,1" >
            <TextBlock Margin="12,0,0,0" Text="{Binding creation_date, StringFormat= Создан: {0}}"  />
        </Border>
        <Border Grid.Column="1" Grid.Row="1" Grid.RowSpan="4"   BorderBrush="Black" BorderThickness="0,0,1,1">
            <TextBlock Text="{Binding duration}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</UserControl>