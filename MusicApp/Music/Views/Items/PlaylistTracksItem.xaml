<UserControl x:Class="Music.Views.Items.PlaylistTracksItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Music.Views.Items"
              MinHeight="100"
              MinWidth="550"
                 Style="{StaticResource TrackUserControlStyle}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Border BorderThickness="1" BorderBrush="Black">
        <Grid  >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <TextBlock VerticalAlignment="Bottom" Margin="15,0,0,5" Text="{Binding name}" TextTrimming ="CharacterEllipsis"/>
            <TextBlock   Margin="10,0,0,0" FontSize="10pt" Grid.Row="1" VerticalAlignment="Top" Text="{Binding artistString}" TextTrimming ="CharacterEllipsis"/>
            <TextBlock Grid.RowSpan="2" Grid.Column="1" VerticalAlignment="Center" Text="{Binding albumName}" TextTrimming ="CharacterEllipsis"/>
            <TextBlock  Grid.RowSpan="2" Grid.Column="2"   VerticalAlignment="Center" Text="{Binding rating}" TextTrimming ="CharacterEllipsis"/>
            <TextBlock  Grid.RowSpan="2" Grid.Column="3"    VerticalAlignment="Center" Text="{Binding duration}" TextTrimming ="CharacterEllipsis"/>
        </Grid>
    </Border>
</UserControl>
