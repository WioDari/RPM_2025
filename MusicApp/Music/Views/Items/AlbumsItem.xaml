<UserControl x:Class="Music.Views.Items.AlbumsItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Music.Views.Items"
             mc:Ignorable="d"
               Style="{StaticResource MainUserControlStyle}"
             d:DesignHeight="200" d:DesignWidth="180"  MaxHeight="200" MaxWidth="180" Background="Transparent" Height="200" Width="180">
    <StackPanel Width="180" Height="200">
        <Border BorderBrush="Black" BorderThickness="1,1,1,0">
            <Image Source="{Binding coverPath}" Height="140" Width="180" Stretch="Fill"/>
        </Border>
        <Border BorderBrush="Black" BorderThickness="1">
            <Grid  Background="White" Margin="2,0,0,0" Height="50">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4*"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding name}" MaxWidth="150" TextTrimming ="CharacterEllipsis"  FontSize="12pt" FontWeight="Bold" />
                <TextBlock Text="{Binding artistName}" Grid.Row="1"/>
                <TextBlock Text="{Binding numberOfTrack}" Grid.Column="1" Grid.RowSpan="2" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
