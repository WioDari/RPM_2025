<Window xmlns:Items="clr-namespace:Music.Views.Items" 
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Music"
        xmlns:Views="clr-namespace:Music.Views" Style="{StaticResource MainWindowStyle}"
        x:Class="Music.MainWindow"
        mc:Ignorable="d"
        Title="MainWindow" ResizeMode="NoResize" Height="600" Width="900">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Background="White">

            <Border MinHeight="40" Margin="10,30,10,10" Background="#ede2ff" CornerRadius="10" BorderBrush="Black" BorderThickness="0,0,0,2">
                <StackPanel Orientation="Horizontal">
                    <Button Margin="8,0,0,0" HorizontalAlignment="Left" BorderBrush="Transparent" Background="Transparent"  Command="{Binding LogoutCommand}" MaxHeight="20" MaxWidth="20">
                        <Image  Source="/Resources/BackArrow.png"/>
                    </Button>
                    <TextBlock  Text="{Binding name}" TextTrimming ="CharacterEllipsis"  Margin="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" />
                </StackPanel>
                
            </Border>


        </StackPanel>
        <StackPanel Grid.Column="1">
            <StackPanel.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FFEDE2FF" />
                    <GradientStop Color="White" Offset="1"/>
                </LinearGradientBrush>
            </StackPanel.Background>
    
            <TabControl   Margin="10,20,10,10"  BorderThickness="0" Background="Transparent">
                <TabItem Style="{DynamicResource MainTabItemStyle}" BorderThickness="0"  Background="#FFEDE2FF"  Header="Альбомы" >
                   
                    <TabItem.Content>
                        <Frame VerticalAlignment="Bottom" HorizontalAlignment="Center" Content="{Binding albumPage}"/>
                    </TabItem.Content>
                </TabItem>
                <TabItem   Style="{DynamicResource MainTabItemStyle}" BorderThickness="0"  Background="#FFEDE2FF"  Header="Плейлисты" >

                    <TabItem.Content>
                        <Frame VerticalAlignment="Top" HorizontalAlignment="Center" Content="{Binding playlistPage}" />
                    </TabItem.Content>
                </TabItem>
            </TabControl>
        </StackPanel>

    </Grid>
</Window>
