<Window x:Class="Music.Views.Windows.AlbumInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Music.Views.Windows"
        Style="{StaticResource AdditionalWindowStyle}"
        xmlns:items="clr-namespace:Music.Views.Items"
        mc:Ignorable="d"
        Title="AlbumInfoWindow" Height="500" Width="800">
    <StackPanel>
        <Border  BorderThickness="1,1,1,0" BorderBrush="Black">
            <StackPanel Orientation="Horizontal">
                <Image  Source="{Binding albumCoverPath}" Stretch="Fill"  Height="120" Width="120" Margin="25,25,10,10" />
                <StackPanel Orientation="Vertical" Margin="0,25,0,0">
                    <TextBlock Text="{Binding albumName}" FontWeight="Bold"/>
                    <TextBlock Text="{Binding albumArtist}"/>
                    <TextBlock Text="{Binding albumGenres}" TextTrimming="CharacterEllipsis" />
                </StackPanel>

            </StackPanel>
        </Border>
        <Frame Content="{Binding currentPage}" NavigationUIVisibility="Hidden"/>
    </StackPanel>
</Window>
