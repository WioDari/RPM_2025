<Window x:Class="Music.Views.Windows.PlaylistInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Music.Views.Windows"
         xmlns:items="clr-namespace:Music.Views.Items"
        Style="{StaticResource AdditionalWindowStyle}"
        mc:Ignorable="d"
        Title="PlaylistInfoWindow" Height="450" Width="800">
    <StackPanel>
        <Border  BorderThickness="1,1,1,0" BorderBrush="Black">
           
                <StackPanel Orientation="Vertical" Margin="10,25,0,0">
                <StackPanel Orientation="Horizontal">
                <TextBlock Margin="10,0,0,0" Text="{Binding name}" FontWeight="Bold" />
                <TextBlock Margin="10,0,0,0" Text=" |" FontWeight="Bold" />
                <TextBlock Margin="10,0,0,0" Text="{Binding creatorName}" FontWeight="Bold" />
                </StackPanel>
                <TextBlock Margin="12,0,0,0" Text="{Binding creation_date, StringFormat= Дата создания: {0}}"  />
                <TextBlock Margin="12,0,0,0" Text="{Binding likes, StringFormat= Лайков: {0}}"  />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Margin="12,0,0,0" Text="Продолжительность: "/>
                    <TextBlock Text="{Binding duration}"/>
                </StackPanel>
            </StackPanel>
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Hidden">
            <ItemsControl Margin="0,0,0,0" ItemsSource="{Binding data}"  >
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <items:PlaylistTracksItem/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </StackPanel>
</Window>
