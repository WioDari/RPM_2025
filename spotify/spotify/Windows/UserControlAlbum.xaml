<UserControl x:Class="spotify.Windows.UserControlAlbum"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:spotify.Windows"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <Style TargetType="ListBoxItem">
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
    </UserControl.Resources>
    <Grid>
        <ListBox Name="AlbumListBox" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>

            <ListBox.ItemTemplate>
                <DataTemplate>
                    
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="155"/>
                                <ColumnDefinition Width="45"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="200"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Grid.ColumnSpan="2" BorderBrush="Black" BorderThickness="0,0,0,2"/>
                        <Image Grid.ColumnSpan="2" Name="NoAlbumCover" Stretch="Uniform" Margin="5" Source="/Resources/placeholder_cover.png"/>
                        <Image Grid.ColumnSpan="2" Name="AlbumCover" Stretch="Uniform" Margin="5" Source="{Binding CoverPath}"/>

                            <StackPanel
                                Grid.Row="1"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center">
                                <TextBlock Text="{Binding AlbumTitle}" Margin="5" FontWeight="Bold" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Artist.ArtistName}" Margin="5"/>
                            </StackPanel>

                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Tracks.Count}" Margin="5"/>
                        </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
