<Window x:Class="spotify.Windows.NewTrack"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:spotify.Windows"
        mc:Ignorable="d"
        Title="Новый трек" Height="550" Width="900" MinHeight="550" MinWidth="900">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="40"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="40"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <Grid Grid.ColumnSpan="4" Background="#9C4DFF">
            <TextBlock Text="Добавление нового трека" FontSize="30" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </Grid>

        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="Название трека:" FontSize="20"/>
                <TextBox Name="TrackTextBox" Height="40" FontSize="20" Background="#EDE2FF" Margin="5" VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Row="1">
                <TextBlock Text="Длительность(чч:мм:сс):" FontSize="20"/>
                <TextBox Name="DurationTextBox" Height="40" FontSize="20" Background="#EDE2FF" Margin="5" Text="00:00:00"/>
            </StackPanel>

            <StackPanel Grid.Row="2">
                <TextBlock Text="Дата релиза:" FontSize="20"/>
                <DatePicker Name="ReleaseDatePicker" Height="40" FontSize="20" Background="#EDE2FF" Margin="5"/>
            </StackPanel>

            <StackPanel Grid.Row="3">
                <TextBlock Text="Битрейт:" FontSize="20"/>
                <TextBox Name="BitrateTextBox" Height="40" FontSize="20" Background="#EDE2FF" Margin="5"/>
            </StackPanel>


            <StackPanel Grid.Row="4">
                <TextBlock Text="Путь к файлу:" FontSize="20"/>
                <TextBox Name="FilePathTextBox" Height="40" FontSize="20" Background="#EDE2FF" Margin="5"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="Исполнитель:" FontSize="20"/>
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox Name="ArtistComboBox" IsTextSearchEnabled="False" IsEditable="True" StaysOpenOnEdit="True" Height="40" GotFocus="ComboBox_GotFocus" LostFocus="ComboBox_LostFocus" Background="#EDE2FF" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="5">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ArtistName}" TextWrapping="Wrap" MaxWidth="250"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Button Grid.Column="1" Name="AddArtistButton" Width="40" Height="40" Margin="5" Background="#7A00CC" BorderThickness="2" BorderBrush="#9C4DFF" Click="AddArtistButton_Click" Padding="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Image Name="Plus1" Source="/Resources/add.png" VerticalAlignment="Center" HorizontalAlignment="Center" Stretch="Uniform" Margin="2"/>
                    </Button>
                </Grid>
            </StackPanel>

            <ListBox Grid.Row="1" Name="ArtistListBox"  VerticalAlignment="Stretch" Margin="5">
                <ListBox.Resources>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    </Style>
                </ListBox.Resources>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{Binding ArtistName}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <Button Grid.Column="1" Name="DeleteArtist" Content="-" Click="DeleteArtist_Click" Width="20" Height="20" Margin="20" Background="#7A00CC" BorderThickness="2" BorderBrush="#9C4DFF" VerticalAlignment="Center" Padding="5"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Grid.Row="2">
                <TextBlock Grid.Row="2" Text="Жанр:" FontSize="20"/>
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox Name="GenreComboBox" IsTextSearchEnabled="False" IsEditable="True" StaysOpenOnEdit="True" Height="40" GotFocus="ComboBox_GotFocus" LostFocus="ComboBox_LostFocus" Background="#EDE2FF" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="5">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Genre1}" TextWrapping="Wrap" MaxWidth="250"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Button Grid.Column="1" Name="AddGenreButton" Width="40" Height="40" Margin="5" Background="#7A00CC" BorderThickness="2" BorderBrush="#9C4DFF" Click="AddGenreButton_Click" Padding="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Image Name="Plus" Source="/Resources/add.png" VerticalAlignment="Center" HorizontalAlignment="Center" Stretch="Uniform" Margin="2"/>
                    </Button>
                </Grid>
            </StackPanel>

            <ListBox Grid.Row="3" Name="GenreListBox" VerticalAlignment="Stretch" Margin="5">
                <ListBox.Resources>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    </Style>
                </ListBox.Resources>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{Binding Genre1}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <Button Grid.Column="1" Name="DeleteGenre" Content="-" Click="DeleteGenre_Click" Width="20" Height="20" Margin="20" Background="#7A00CC" BorderThickness="2" BorderBrush="#9C4DFF" VerticalAlignment="Center" Padding="5"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <Button Name="CloseButton" Grid.Column="2" Grid.ColumnSpan="2" Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" Content="Выход" FontSize="20" Background="#7A00CC" BorderThickness="2" BorderBrush="#9C4DFF" Click="CloseButton_Click"/>

        <Button Name="NewTrackButton"  Grid.ColumnSpan="2" Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" Content="Добавить" FontSize="20" Background="#7A00CC" BorderThickness="2" BorderBrush="#9C4DFF" Click="NewTrackButton_Click"/>

    </Grid>
</Window>
