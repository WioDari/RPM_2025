<Window x:Class="spotify.Windows.NewAlbum"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:spotify.Windows"
        mc:Ignorable="d"
        Title="NewAlbum" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <Grid
            Grid.ColumnSpan="3"
            Background="#9C4DFF">
            <TextBlock Text="Добавление нового альбома" FontSize="30" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </Grid>

        <Image Name="AlbumCover" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Stretch="Uniform" Margin="5"/>

        <Grid
            Grid.Row="1"
            Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>


            <TextBlock Text="Название альбома:" FontSize="20"/>
            <TextBox Name="AlbumTextBox" Width="250" Height="40" FontSize="20" Background="#EDE2FF"/>

            <TextBlock Grid.Row="1" Text="Год выпуска:" FontSize="20"/>
            <TextBox Grid.Row="1" Name="YearTextBox" Width="250" Height="40" FontSize="20" Background="#EDE2FF"/>

            <TextBlock Grid.Row="2" Text="Ссылка на изображение:" FontSize="20"/>
            <TextBox Grid.Row="2" Name="CoverPathTextBox" Width="250" Height="40" FontSize="20" Background="#EDE2FF"/>
        </Grid>

        <Grid
            Grid.Row="1"
            Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Исполнитель:" FontSize="20" Margin="5"/>
            <ComboBox Name="ArtistComboBox" IsTextSearchEnabled="False" IsEditable="True" StaysOpenOnEdit="True" Width="250" Height="40" GotFocus="ComboBox_GotFocus" LostFocus="ComboBox_LostFocus" Background="#EDE2FF">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding ArtistName}" TextWrapping="Wrap" MaxWidth="250"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            
            <StackPanel Grid.Row="1">
                <TextBlock Text="Жанр:" FontSize="20" Margin="5"/>

                <StackPanel Orientation="Horizontal" Margin="5">
                    <ComboBox Name="GenreComboBox" Grid.Row="1" IsTextSearchEnabled="False" IsEditable="True" StaysOpenOnEdit="True" Width="200" Height="40" GotFocus="ComboBox_GotFocus" LostFocus="ComboBox_LostFocus" Background="#EDE2FF" Margin="5">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Genre1}" TextWrapping="Wrap" MaxWidth="250"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Button Name="AddGenreButton" Width="40" Height="40" Margin="5" Background="#7A00CC" BorderThickness="2" BorderBrush="#9C4DFF" Click="AddGenreButton_Click" Padding="0">
                        <Image Name="Plus" Height="25" Width="25" Source="/Resources/add.png" VerticalAlignment="Center" HorizontalAlignment="Center" Stretch="Uniform"/>
                    </Button>
                </StackPanel>
                

                <ListBox Name="GenreListBox" Grid.Row="1" Width="250" Height="40" Margin="5">

                </ListBox>
            </StackPanel>
            
        </Grid>

        <Button Name="CloseButton" Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" Content="Выход" FontSize="20" Background="#7A00CC" BorderThickness="2" BorderBrush="#9C4DFF" Click="CloseButton_Click"/>
        
        <Button Name="NewAlbumButton"  Grid.ColumnSpan="2" Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" Content="Добавить" FontSize="20" Background="#7A00CC" BorderThickness="2" BorderBrush="#9C4DFF" Click="NewAlbumButton_Click"/>
    </Grid>
</Window>
