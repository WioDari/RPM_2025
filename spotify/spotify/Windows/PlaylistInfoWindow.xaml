<Window x:Class="spotify.Windows.PlaylistInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:spotify.Windows"
        xmlns:m="clr-namespace:spotify.Models"
        mc:Ignorable="d"
        Title="Информация о плейлисте" MinHeight="450" MinWidth="800" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="40"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="40"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <Grid Grid.ColumnSpan="3" Background="#9C4DFF">
            <TextBlock Grid.ColumnSpan="3" Text="Информация плейлиста" FontSize="30" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </Grid>

        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Name="TitleTextBlock" Text="{Binding PlaylistNameAndFullName}" VerticalAlignment="Center" Margin="5" FontWeight="Bold" FontSize="22"/>

                <TextBlock Name="DateTextBlock" Grid.Row="1" Text="{Binding DateCreatedString, StringFormat='Дата создания: {0}'}" Margin="5"/>

                <TextBlock Name="LikesTextBlock" Grid.Row="2" Text="{Binding Likes, StringFormat='Лайков: {0}'}" Margin="5"/>

                <TextBlock Name="Duration" Grid.Row="3" Text="{Binding Duration, StringFormat='Продолжительность: {0}'}" Margin="5"/>
            </Grid>

            <ListBox Grid.Row="1" Name="TrackListBox" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="5">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="m:Track">
                        <Border  BorderBrush="Black" BorderThickness="2" Margin="5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="{Binding TrackName}" VerticalAlignment="Center" Margin="5" TextWrapping="Wrap" FontWeight="Bold" FontSize="18"/>
                                <TextBlock Grid.Row="1" Text="{Binding ArtistsToString}" VerticalAlignment="Center" Margin="5" FontSize="16"/>
                                <Border Grid.RowSpan="2" BorderThickness="0,0,2,0" BorderBrush="Black"/>

                                <TextBlock Grid.Column="1" Grid.RowSpan="2" Text="{Binding AlbumTitle}" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="5" FontSize="16"/>
                                <Border Grid.Column="1" Grid.RowSpan="2" BorderThickness="0,0,2,0" BorderBrush="Black"/>

                                <TextBlock Grid.Column="2" Grid.RowSpan="2" Text="{Binding Rating}" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="5" FontSize="16"/>
                                <Border Grid.Column="2" Grid.RowSpan="2" BorderThickness="0,0,2,0" BorderBrush="Black"/>

                                <TextBlock Grid.Column="3" Grid.RowSpan="2" Text="{Binding Duration}" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="5" FontSize="16"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <Grid Grid.Row="2" Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Name="CloseButton" Click="CloseButton_Click" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Content="Выход" FontSize="20" Background="#7A00CC" BorderThickness="2" BorderBrush="#9C4DFF"/>
            <Button Name="ChangeButton" VerticalAlignment="Center" HorizontalAlignment="Center" Content="Изменить" FontSize="20" Background="#7A00CC" BorderThickness="2" BorderBrush="#9C4DFF" Click="ChangeButton_Click"/>
        </Grid>
    </Grid>
</Window>
