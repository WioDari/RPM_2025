<UserControl x:Class="spotify.Windows.UserControlPlaylist"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:spotify.Windows"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <ListBox Name="PlaylistListBox" FontSize="16" Margin="10">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border  BorderBrush="Black" BorderThickness="2" Margin="5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="500"/>
                                <ColumnDefinition Width="90"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="40"/>
                                <RowDefinition Height="120"/>
                            </Grid.RowDefinitions>

                            <Border Grid.ColumnSpan="2" BorderThickness="0,0,0,2" BorderBrush="Black"/>

                            <Border Grid.Row="1" BorderBrush="Black" BorderThickness="0,0,2,0"/>
                            <TextBlock Text="{Binding PlaylistAndCreator}" VerticalAlignment="Center" Margin="5" FontWeight="Bold"/>
                            <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding DurationString}"  VerticalAlignment="Center" Margin="5"/>
                            <StackPanel
                                Grid.Row="1"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left">
                                <TextBlock Text="{Binding Likes, StringFormat='Нравится: {0}'}" Margin="5"/>
                                <TextBlock Text="{Binding Users.Count, StringFormat='Подписчиков: {0}'}" Margin="5"/>
                                <TextBlock Text="{Binding Tracks.Count, StringFormat='Треков: {0}'}" Margin="5"/>
                                <TextBlock Text="{Binding DateCreatedString, StringFormat='Создан: {0}'}" Margin="5"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
