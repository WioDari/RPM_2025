<Window x:Class="Music.Windows.MenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Music.Windows" 
        xmlns:UserControls="clr-namespace:Music.UserControls"
        mc:Ignorable="d"
        Title="Музыка+" Height="900" Width="1600" MinHeight="900" MinWidth="1600"
        WindowStartupLocation="CenterScreen"
        >
    <Window.Resources>
        <Style TargetType="TabPanel">
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="15, 8"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="130"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="105"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Background="{StaticResource PrimaryAccentColorBrush}" Grid.ColumnSpan="3"/>
        <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Text="Музыка+" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold" FontSize="55" Foreground="White"/>

        <Grid Grid.Row="1" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="1">
                <TextBlock Name="UserFullNameTextBlock" Text="Имя пользователя"  TextAlignment="Center" VerticalAlignment="Top" FontWeight="Bold" Margin="20,20,20,5" TextWrapping="Wrap"/>
                <TextBlock Name="UserRoleTextBlock" Text="Роль пользователя"  TextAlignment="Center" VerticalAlignment="Top" Margin="20,0,20,20" TextWrapping="Wrap"/>
            </StackPanel>

            <Button Grid.Row="2" Name="NewPlaylistButton" VerticalAlignment="Center" HorizontalAlignment="Center" Content="Добавить плейлист" Click="NewPlaylistButton_Click"/>
            <Button Grid.Row="3" Name="NewAlbumButton" VerticalAlignment="Center" HorizontalAlignment="Center" Content="Добавить альбом" Click="NewAlbumButton_Click"/>

            <Button
                Grid.Row="5"
                Content="Выйти из аккаунта" 
                HorizontalAlignment="Center" VerticalAlignment="Bottom" 
                Click="ExitButton_Click"
                Background="{StaticResource PrimaryAccentColorBrush}"
                BorderBrush="{StaticResource SecondaryAccentColorBrush}"/>

        </Grid>

        <TabControl Grid.Row="1" Grid.Column="1" Grid.RowSpan="2" HorizontalAlignment="Stretch" Margin="0 0 0 30">
            <TabItem Header="Альбомы">
                <ContentPresenter Name="Albums">
                    <d:ContentPresenter.Content>
                        <UserControls:AlbumsUserControl/>
                    </d:ContentPresenter.Content>
                </ContentPresenter>
            </TabItem>

            <TabItem Header="Плейлисты">
                <ContentPresenter Name="Playlists"/>
            </TabItem>

            <TabItem Header="Пользователи" Name="UsersTabItem">
                <ContentPresenter x:Name="Users">
                    <d:ContentPresenter.Content>
                        <UserControls:UsersUserControl/>
                    </d:ContentPresenter.Content>
                </ContentPresenter>
            </TabItem>
        </TabControl>

        <TextBlock Name="Timer" Text="1:00:00" Grid.Row="2" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="20"/>

    </Grid>
</Window>
