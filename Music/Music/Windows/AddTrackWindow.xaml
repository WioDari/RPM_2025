<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Music.Windows"
        xmlns:u="clr-namespace:Music.UserControls"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:Models="clr-namespace:Music.Models" x:Class="Music.Windows.AddTrackWindow"
        WindowStartupLocation="CenterScreen"
        mc:Ignorable="d"
        Title="Создание трека" Height="900" Width="1200" MinHeight="900" MinWidth="1200">
    <Window.DataContext>
        <Models:Track/>
    </Window.DataContext>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="5*"/>
            <ColumnDefinition Width="50"/>
            <ColumnDefinition Width="5*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="130"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="105"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Background="{StaticResource PrimaryAccentColorBrush}" Grid.ColumnSpan="5"/>
        <TextBlock Grid.Row="0" Grid.ColumnSpan="5" Text="Музыка+" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold" FontSize="55" Foreground="White"/>

        <StackPanel Grid.Row="1" Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="Название трека:"/>
            <TextBox Name="TrackNameBox" VerticalAlignment="Center" Text="{Binding TrackName}"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="Длительность трека:"/>
            <xctk:MaskedTextBox
                 x:Name="DurationStringBox"
                 Mask="00:00:00"
                 ValueDataType="{x:Type sys:String}"
                 Text="{Binding DurationString}">
                <xctk:MaskedTextBox.Resources>
                    <Style TargetType="{x:Type xctk:MaskedTextBox}">
                        <Setter Property="Background" Value="{StaticResource SecondaryBackgroundColorBrush}"/>
                        <Setter Property="Padding" Value="15"/>
                        <Setter Property="FontSize" Value="30"/>
                        <Setter Property="BorderThickness" Value="3"/>
                        <Setter Property="FontFamily" Value="Times New Roman"/>
                        <Setter Property="BorderBrush" Value="{StaticResource PrimaryAccentColorBrush}"/>
                        <Setter Property="Foreground" Value="{StaticResource PrimaryTextColorBrush}"/>
                    </Style>
                </xctk:MaskedTextBox.Resources>
            </xctk:MaskedTextBox>
        </StackPanel>

        <StackPanel Grid.Row="3" Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="Дата выхода:"/>
            <DatePicker Name="ReleaseDateTimePicker" 
                        Style="{DynamicResource DatePickerStyle1}" 
                        VerticalContentAlignment="Center" 
                        BorderThickness="3"
                        SelectedDate="{Binding ReleaseDateTime}">
                <DatePicker.Resources>
                    <Style TargetType="{x:Type DatePickerTextBox}">
                        <Setter Property="Background" Value="{StaticResource SecondaryBackgroundColorBrush}"/>
                        <Setter Property="Padding" Value="15"/>
                        <Setter Property="BorderThickness" Value="3"/>
                        <Setter Property="FontFamily" Value="Times New Roman"/>
                        <Setter Property="BorderBrush" Value="{StaticResource PrimaryAccentColorBrush}"/>
                        <Setter Property="Foreground" Value="{StaticResource PrimaryTextColorBrush}"/>
                    </Style>
                </DatePicker.Resources>
                <DatePicker.BorderBrush>
                    <StaticResource ResourceKey="PrimaryAccentColorBrush"/>
                </DatePicker.BorderBrush>
            </DatePicker>
        </StackPanel>

        <StackPanel Grid.Row="4" Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="Битрейт:"/>
            <TextBox Name="BitrateBox" Text="{Binding Bitrate}"/>
        </StackPanel>

        <StackPanel Grid.Row="5" Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="Путь к файлу:"/>
            <TextBox Name="FilePathBox" Text="{Binding FilePath}" ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
        </StackPanel>

        <ListBox Name="ArtistsListBox" Grid.Column="3" Grid.Row="2" Grid.RowSpan="1" ItemsSource="{Binding Artists}">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="Models:Artist">
                    <Grid ShowGridLines="False">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" 
                           HorizontalAlignment="Stretch"/>

                        <Button Grid.Column="1" Content="—" 
                            FontWeight="Black" FontSize="40" 
                            Width="50" Height="50" 
                            Margin="10,0,0,0" Padding="10 0 10 8"
                            VerticalAlignment="Center" VerticalContentAlignment="Center"
                            HorizontalAlignment="Right" HorizontalContentAlignment="Center"
                            Click="RemoveArtist_Click"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="1" Grid.Column="3" VerticalAlignment="Center">
            <TextBlock Text="Исполнители:"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <u:AutoCompleteBox x:Name="ArtistBox" FontSize="30" VerticalAlignment="Stretch" />
                <Button Grid.Column="1" Name="AddArtistButton" Content="+" FontWeight="Black" FontSize="60" Height="70" Width="70" Margin="10,0,0,0" Click="AddArtistButton_Click" />
            </Grid>
        </StackPanel>

        <StackPanel Grid.Row="3" Grid.Column="3" VerticalAlignment="Center">
            <TextBlock Text="Жанры:"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <u:AutoCompleteBox x:Name="GenresBox" FontSize="30" VerticalAlignment="Stretch" />
                <Button Grid.Column="1" Name="AddGenreButton" Content="+" FontWeight="Black" FontSize="60" Height="70" Width="70" Margin="10,0,0,0" Click="AddGenreButton_Click" />
            </Grid>            
        </StackPanel>

        <ListBox Name="GenresListBox" Grid.Column="3" Grid.Row="4" Grid.RowSpan="2" ItemsSource="{Binding Genres}">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="Models:Genre">
                    <Grid ShowGridLines="False">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" 
                           HorizontalAlignment="Stretch"/>
                        <Button Grid.Column="1" Content="—" 
                            FontWeight="Black" FontSize="40" 
                            Width="50" Height="50" 
                            Margin="10,0,0,0" Padding="10 0 10 8"
                            VerticalAlignment="Center" VerticalContentAlignment="Center"
                            HorizontalAlignment="Right" HorizontalContentAlignment="Center"
                            Click="RemoveGenre_Click"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Orientation="Horizontal" Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="5" HorizontalAlignment="Center" VerticalAlignment="Center" >
            <Button
                Content="Отмена" 
                HorizontalAlignment="Center" VerticalAlignment="Center" 
                Click="ExitButton_Click"
                Background="{StaticResource ErrorColorBrush}"
                BorderBrush="{StaticResource SecondaryAccentColorBrush}" Margin="0,0,20,0"/>
            <Button 
                x:Name="SaveButton" 
                Content="Добавить" 
                Foreground="White" Margin="20,0,0,0"
                Background="{StaticResource SuccessColorBrush}"
                BorderBrush="{StaticResource SecondaryAccentColorBrush}"
                Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
