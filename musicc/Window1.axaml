<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:musicc="clr-namespace:musicc"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="musicc.Window1"
        Title="YouMain"
        x:DataType="musicc:Window1" FontFamily="Times New Roman" FontSize="12" MinHeight="480" MinWidth="480">
        <Window.Styles>
                <Style Selector="TextBlock">
                        <Setter Property="FontSize" Value="14"/>
                        <Setter Property="Foreground" Value="#2D3748"/>
                </Style>
        
                <Style Selector="TextBox">
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="BorderBrush" Value="#E2E8F0"/>
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="Foreground" Value="#4A5568"/>
                        <Setter Property="Padding" Value="12"/>
                        <Setter Property="CornerRadius" Value="8"/>
                        <Setter Property="FontSize" Value="14"/>
                </Style>
        
                <Style Selector="TextBox:focus">
                        <Setter Property="BorderBrush" Value="#7A00CC"/>
                        <Setter Property="BorderThickness" Value="2"/>
                </Style>
        
                <Style Selector="Button">
                        <Setter Property="Background" Value="#7A00CC"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="16,12"/>
                        <Setter Property="CornerRadius" Value="8"/>
                        <Setter Property="FontSize" Value="14"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Cursor" Value="Hand"/>
                </Style>
        
                <Style Selector="Button:pointerover">
                        <Setter Property="Background" Value="#6A00B8"/>
                        <Setter Property="Opacity" Value="0.95"/>
                </Style>
        
                <Style Selector="Button:pressed">
                        <Setter Property="Background" Value="#5A00A4"/>
                        <Setter Property="Opacity" Value="0.9"/>
                </Style>
                <Style Selector="TabItem:selected /template/ Border#PART_SelectedPipe">
                        <Setter Property="Height" Value="0"/>
                </Style>
        </Window.Styles>
        
        
        
        <TabControl >
                <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Top" HorizontalAlignment="Left" Text="{Binding Boxname}" TextWrapping="Wrap" 
                           Background="#EDE2FF"   TextAlignment="Center" ></TextBlock>
                <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Top" HorizontalAlignment="Left" Text="{Binding Boxname}" TextWrapping="Wrap" 
                           Background="#EDE2FF"   TextAlignment="Center" ></TextBlock>
                <TabItem Header="Playlists" Foreground="#7A00CC">
                        <ListBox ItemsSource="{Binding Playlists}" Margin="5">
                                <ListBox.ItemTemplate>
                                        <DataTemplate>
                                                <Border BorderBrush="Black" BorderThickness="2">
                                                <StackPanel Margin="5">
                                                        <StackPanel Orientation="Horizontal" Spacing="5" >
                                                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold"/>
                                                        <TextBlock Text="| " FontWeight="Bold" FontSize="16"/>
                                                        <TextBlock Text="{Binding author}" FontSize="16" FontWeight="Bold"/>
                                                        </StackPanel>
                                                        <Grid ColumnDefinitions="*,*" RowDefinitions="*,*,*,*">
                                                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="5" HorizontalAlignment="Right" Grid.Column="1">
                                                                <TextBlock Text="Время:" FontWeight="Bold"></TextBlock>
                                                        </StackPanel>
                                                                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="5" Grid.Column="0">
                                                                <TextBlock Text="Нравится:" FontWeight="Bold"/>
                                                                <TextBlock Text="{Binding like}"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="5" Grid.Column="0">
                                                                <TextBlock Text="Подписчиков:" FontWeight="Bold"/>
                                                                <TextBlock Text="{Binding subs}"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="5" Grid.Column="0">
                                                                <TextBlock Text="Треков:" FontWeight="Bold"/>
                                                                <TextBlock Text="{Binding track}"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="5" Grid.Column="0">
                                                                <TextBlock Text="Создан:" FontWeight="Bold"/>
                                                                <TextBlock Text="{Binding data}"/>
                                                        </StackPanel>
                                                        </Grid>
                                                </StackPanel>
                                                </Border>
                                        </DataTemplate>
                                </ListBox.ItemTemplate>
                        </ListBox>
                </TabItem>
                <TabItem Header="Albums" Foreground="#7A00CC">
                        <ScrollViewer HorizontalAlignment="Right" Foreground="#9C4DFF" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Albums}">
                                <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" ItemWidth="150" ItemHeight="200"></WrapPanel>
                                        </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                                <StackPanel>
                                                        <Border Width="140" ClipToBounds="True" Height="190" Background="#9C4DFF"  CornerRadius="10">
                                                                <StackPanel>
                                                                <Image Source="{Binding photo}" Height="130" Width="130" Margin="0,5,0,0" ></Image>
                                                                <TextBlock Foreground="White" Text="{Binding Name}" TextAlignment="Center"></TextBlock>
                                                                <TextBlock Foreground="White" Text="{Binding author}" TextAlignment="Center"></TextBlock>
                                                                <TextBlock Foreground="White" Text="{Binding track}" TextAlignment="Right"></TextBlock>        
                                                                </StackPanel>
                                                        </Border>
                                                </StackPanel>
                                        </DataTemplate>
                                </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </ScrollViewer>
                </TabItem>
                <TabItem Header="Music" Foreground="#7A00CC"></TabItem>
                <TabItem Header="Artist" Foreground="#7A00CC"></TabItem>
                
        </TabControl>
        
       
        
        
</Window>
