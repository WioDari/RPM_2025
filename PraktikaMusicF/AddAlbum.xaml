<Window x:Class="PraktikaMusicF.AddAlbum"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PraktikaMusicF"
        mc:Ignorable="d"
        Style="{StaticResource WindowStyleG}"
        Title="AddAlbum" Height="470" Width="820"
        MaxHeight="470" MaxWidth="820"
        MinHeight="470" MinWidth="820">
    <Window.Resources>
        <Style x:Key="PurpleButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#7A00CC"/>
            <Setter Property="BorderBrush" Value="#9C4DFF"/>
            <Setter Property="Foreground" Value="#EDE2FF"/>
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="Padding" Value="10 5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="15"
                    SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#7A00CC"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#9C4DFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#B88FFF"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#9C4DFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="Black"/>

                            </Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0"
              Grid.ColumnSpan="4"
              Background="#9C4DFF"/>
        <Button Style="{StaticResource PurpleButtonStyle}" 
                Margin="56,5,10,5"
                Grid.Column="3"
                Content="Выход"
                Click="Button_Click"/>
        <TextBlock Grid.Column="1"
                   Grid.ColumnSpan="2"
                   Text="Добавление альбома"
                   Foreground="#EDE2FF"
                   FontSize="38"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center">
        </TextBlock>
        <TextBlock Grid.Row="1"
                   Text="Название альбома:"
                   Margin="5,18,5,143">
        </TextBlock>
        <TextBlock Grid.Row="1"
                   Text="Исполнитель:" Margin="5,69,4,96"/>
        <TextBlock Text="Дата выхода:"
                   Grid.Row="1" Margin="5,125,6,40"/>
        <TextBlock Text="Жанры:"
                   Grid.Row="2" Margin="6,8,4,148"/>
        <Border Grid.Row="1" 
                Margin="10,13,10,143" 
                Grid.Column="1" 
                BorderThickness="2,2,2,2">
            <TextBox Name="nameAlb"
                     Background="#EDE2FF"/>
        </Border>
        <ComboBox  Grid.Column="1"
                   Grid.Row="1" Margin="10,67,10,94"
                   Name="comboArt"
                   Background="#EDE2FF" 
                   Text="Выберите Артиста"
                   SelectionChanged="comboArt_SelectionChanged">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding ArtName}">
                    </TextBlock>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
        <Border Grid.Row="1" 
                Margin="35,24,65,132" 
                Grid.Column="2"
                Grid.ColumnSpan="2"
                BorderThickness="2,2,2,2">
            <TextBox Name="urlLinkImage"
                     Background="#EDE2FF"/>
        </Border>
        <Image Source="C:\Users\damir\source\repos\PraktikaMusicF\PraktikaMusicF\Resources\covers\CD_DEFAULT_IMAGE.jpg"
               Stretch="UniformToFill"
               Margin="5"
               Grid.Column="2"
               Grid.ColumnSpan="2"
               Grid.Row="1"
               Grid.RowSpan="2"
               Width="230"
               Height="230"/>
        <Image Height="230"
               Grid.Column="2"
               Grid.ColumnSpan="2"
               Grid.Row="1"
               x:Name="albImage"
               Grid.RowSpan="2" 
               Width="230" Margin="85,71,85,83"/>
        <DatePicker Margin="10,120,10,35" 
                    Grid.Row="1" 
                    Grid.Column="1"
                    Name="datePicker"
                    Background="#EDE2FF"/>
        <ListBox Grid.Row="2"
                 Grid.Column="1"
                 Margin="7,7,7,7"
                 Name="genreList"
                 SelectionMode="Multiple"
                 SelectionChanged="genreList_SelectionChanged"
                 Background="#EDE2FF">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding GenresName}">
                    </TextBlock>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Button Grid.Row="1"
                Grid.Column="3" 
                Margin="152,25,9,135"
                Name="LoadImage"
                Click="LoadImage_Click">
            <Image Source="C:\Users\damir\source\repos\PraktikaMusicF\PraktikaMusicF\Resources\zagruzka.png" Width="34"
                   Stretch="UniformToFill" Height="35">
            </Image>
        </Button>
        <Button Grid.Row="2"
                Grid.Column="2"
                Grid.ColumnSpan="2" 
                Margin="100,120,100,33"
                Style="{StaticResource PurpleButtonStyle}"
                Content="Сохранить"
                Name="saveAlb"
                Click="saveAlb_Click">
        </Button>
    </Grid>
</Window>
