<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="350"
        x:Class="BelokonevPRM.Windows.LogWindow"
        MaxHeight="350" MaxWidth="400"
        Title="logWindow">
        <Grid ShowGridLines="False"
              RowDefinitions="0.3*,*,0.25*">
            <Grid Grid.Row="0"
                  Background="#9C4DFF">
                <TextBlock
                    FontSize="30"
                    FontWeight="Bold"
                    Foreground="White"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
                    Авторизация
                </TextBlock>
            </Grid>
            <Grid Grid.Row="1"
                  ShowGridLines="False"
                  RowDefinitions="*,*,*,*,*"
                  ColumnDefinitions="*">
                <Grid Grid.Row="0"
                      ColumnDefinitions="0.1*,*,*,0.3*">
                    <TextBlock
                        Grid.Column="1"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center">
                        Введите логин:
                    </TextBlock>
                    <TextBox
                        HorizontalAlignment="Left"
                        Grid.Column="2"
                        Grid.ColumnSpan="2"
                        Name="LoginBox"
                        Text="apollinariya.allenova"
                        VerticalAlignment="Center"/>
                </Grid>
                <Grid
                    Grid.Row="1"
                    ColumnDefinitions="0.1*,*,*,0.3*">
                    <TextBlock
                        Grid.Column="1"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center">
                        Введите пароль:
                    </TextBlock>
                    <TextBox
                        Grid.Column="2"
                        Name="PasswordBox"
                        Text="sXFdIl0y"
                        PasswordChar="*"
                        VerticalAlignment="Center"/>
                    <Button
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Grid.Column="3"
                        Content="*"
                        Click="ChangePasswordVisibility"/>
                </Grid>
                <Grid
                    ShowGridLines="False"
                    RowDefinitions="0.4*,0.1*,*"
                    Grid.Row="2"
                    RowSpan="3">
                    <Grid
                        ShowGridLines="False"
                        Grid.Row="0"
                        ColumnDefinitions="0.1*,*,*,0.3*">
                        <TextBlock
                            Grid.Column="1"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center">
                            Введите код:
                        </TextBlock>
                        <TextBox
                            Name="CaptchaBox"
                            Grid.Column="2"
                            VerticalAlignment="Center"/>
                        <Button
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Grid.Column="3"
                            Click="RefreshCaptchaButton_Click"
                            Content="*"/>
                    </Grid>
                    <Grid
                        Grid.Row="2">
                        <Image
                            Name="CaptchaImg"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Width="200"
                            Height="80"/>
                    </Grid>
                </Grid>
            </Grid>
            <Grid ShowGridLines="False"
                  ColumnDefinitions="*,*"
                  Grid.Row="2">
                <Button Grid.Column="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Content="Гостевой вход"/>
                <Button
                    Grid.Column="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Content="Войти"
                    Click="LoginOnClick"/>
            </Grid>
        </Grid>
</Window>
