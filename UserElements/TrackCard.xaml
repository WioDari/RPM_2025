<UserControl x:Class="PracticeWork.UserElements.TrackCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PracticeWork.UserElements"
             xmlns:viewmodels="clr-namespace:PracticeWork.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" Width="586" Height="176">
    <Grid>
        <StackPanel Orientation="Horizontal">
            <Image Height="176" Width="176" Source="{Binding image}"/>
            <StackPanel Width="482">
                <TextBlock TextWrapping="Wrap" Height="29" Text="{Binding name, StringFormat=Название: {0}}" />
                <TextBlock TextWrapping="Wrap" Height="29" Text="{Binding artist, StringFormat=Исполнитель: {0}}" />
                <TextBlock TextWrapping="Wrap" Height="29" Text="{Binding description, StringFormat=О треке: {0}}" />
                <TextBlock TextWrapping="Wrap" Height="29" Text="{Binding duration, StringFormat=Продолжительность: {0}}" />
                <TextBlock TextWrapping="Wrap" Height="29" Text="{Binding releaseDate, StringFormat=Выпущен {0}}" />
                <TextBlock TextWrapping="Wrap" Height="29" Text="{Binding totalplays, StringFormat=Прослушали {0} раз}" />
            </StackPanel>
            <TextBlock TextAlignment="Center" TextWrapping="Wrap" Width="141" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="32" Text="{Binding rate}" />
        </StackPanel>

    </Grid>
</UserControl>
