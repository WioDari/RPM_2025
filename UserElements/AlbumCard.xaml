<UserControl x:Class="PracticeWork.UserElements.AlbumCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PracticeWork.UserElements"
             mc:Ignorable="d" Height="346" Width="255">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="127*"/>
            <RowDefinition Height="45*"/>
        </Grid.RowDefinitions>
        <Image HorizontalAlignment="Left" Height="255" VerticalAlignment="Top" Width="255" Source="{Binding albumImage}"/>
        <TextBlock HorizontalAlignment="Left" TextWrapping="Wrap" Text="{Binding totalTracks}" VerticalAlignment="Center" Margin="184,0,0,0" Height="90" Width="71" Grid.Row="1" FontWeight="Bold"/>
        <TextBlock HorizontalAlignment="Left" TextWrapping="Wrap" Text="{Binding Autor}" VerticalAlignment="Top" Margin="0,45,0,0" Height="46" Width="184" Grid.Row="1"/>
        <TextBlock HorizontalAlignment="Left" TextWrapping="Wrap" Text="{Binding Title}" VerticalAlignment="Top" Margin="0,255,0,0" Grid.RowSpan="2" Height="46" Width="184"/>
    </Grid>
</UserControl>
