<UserControl x:Class="PracticeWork.Windows.Tracks"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PracticeWork.UserElements"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="AliceBlue">
        <ListView ItemsSource="{Binding data, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,157,0">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <local:TrackCard></local:TrackCard>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <StackPanel Margin="643,0,0,0">
            <TextBlock Text="Фильтры" FontFamily="Times New Roman" TextAlignment="Center" HorizontalAlignment="Center" Height="29" FontSize="24"/>
            <ComboBox Width="120" Margin="0,15,0,0"/>
            <ComboBox Width="120" Margin="0,15,0,0"/>
            <ComboBox Width="120" Margin="0,15,0,0"/>
        </StackPanel>

    </Grid>
</UserControl>
