<UserControl x:Class="PracticeWork.UserElements.PlayListCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PracticeWork.UserElements"
             mc:Ignorable="d" 
             d:DesignHeight="176" d:DesignWidth="586">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="37*"/>
            <RowDefinition Height="139*"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal">
            <TextBlock FontWeight="Bold" TextWrapping="Wrap" Text="{Binding Title, StringFormat=Название {0}}"/>
            <TextBlock FontWeight="Bold" TextWrapping="Wrap" Text="  |  "/>
            <TextBlock FontWeight="Bold" TextWrapping="Wrap" Text="{Binding Author, StringFormat=Создатель {0}}"/>

        </StackPanel>
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4*"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Vertical">
                <TextBlock TextWrapping="Wrap" Text="{Binding Likes, StringFormat=Нравится {0} людям}" Height="30"/>
                <TextBlock TextWrapping="Wrap" Text="{Binding Subs, StringFormat=Подписчиков {0}}" Height="30"/>
                <TextBlock TextWrapping="Wrap" Text="{Binding Tracks, StringFormat=Всего {0} композиций}" Height="30"/>
                <TextBlock TextWrapping="Wrap" Text="{Binding CreatedAt, StringFormat=Создан {0}}" Height="30"/>
            </StackPanel>
            <TextBlock Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding Duration}"/>

        </Grid>
    </Grid>
</UserControl>
