<Page x:Class="Spotify_wpf.Views.Album"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Spotify_wpf.Views"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Album">

    <Grid Background="White">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="379*"/>
            <ColumnDefinition Width="168*"/>
            <ColumnDefinition Width="168*"/>
            <ColumnDefinition Width="75*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="23*"/>
            <RowDefinition Height="127*"/>
        </Grid.RowDefinitions>
        <ListBox ItemsSource="{Binding albums}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectedItem="{Binding selectedAlbim}"  Grid.Row="1" Grid.ColumnSpan="4">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <local:AlbumUserControl/>
                </DataTemplate>
            </ListBox.ItemTemplate>

        </ListBox>
        <TextBox TextWrapping="Wrap" Text="{Binding searchText, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Grid.Column="0" Height="Auto" Width="Auto" Margin="10,0,10,0" MinHeight="30"/>
        <ComboBox Grid.Column="1" VerticalAlignment="Center" Width="Auto" Height="Auto" MinHeight="30" FontFamily="Times New Roman" ItemsSource="{Binding genres}" FontSize="20" SelectedItem="{Binding selectedGenres}"/>
        <StackPanel Grid.Column="2" Height="Auto" Width="Auto" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="10" MinHeight="30">
            <RadioButton Content="По возрастанию" Height="14" Width="160" HorizontalAlignment="Left" VerticalAlignment="Center" FontFamily="Times New Roman" FontSize="14"/>
            <RadioButton Grid.Column="2" Content="По убыванию" HorizontalAlignment="Left" VerticalAlignment="Center" Height="14" Width="160"  FontFamily="Times New Roman" FontSize="14"/>


        </StackPanel>
      
       


    </Grid>
</Page>
