<Page x:Class="Spotify_wpf.Views.Album"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Spotify_wpf.Views"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Album">

    <Grid Background="White">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="384*"/>
            <ColumnDefinition Width="170*"/>
            <ColumnDefinition Width="137*"/>
            <ColumnDefinition Width="109*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="23*"/>
            <RowDefinition Height="127*"/>
        </Grid.RowDefinitions>
        <ListBox ItemsSource="{Binding albums}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectedItem="{Binding selectedAlbim}"  Grid.Row="1" Grid.ColumnSpan="4">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <local:AlbumUserControl/>
                </DataTemplate>
            </ListBox.ItemTemplate>

        </ListBox>
        <TextBox TextWrapping="Wrap" Text="{Binding searchText, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Grid.Column="0" Height="30" Width="Auto" Margin="10,0,10,0" MinHeight="30" IsEnabled="{Binding ., Converter={StaticResource GuestConverter}}"/>
        <ComboBox Grid.Column="1" VerticalAlignment="Center" Width="Auto" Height="30" MinHeight="30" FontFamily="Times New Roman" ItemsSource="{Binding genres}" FontSize="20" SelectedItem="{Binding selectedGenres}" IsEnabled="{Binding ., Converter={StaticResource GuestConverter}}"/>
        <StackPanel Grid.Column="2" Height="30" Width="Auto" VerticalAlignment="Center" Margin="10,0,10,0" MinHeight="30" IsEnabled="{Binding ., Converter={StaticResource GuestConverter}}">
            <RadioButton Content="По возрастанию" Height="14" Width="160" HorizontalAlignment="Left" VerticalAlignment="Center" FontFamily="Times New Roman" FontSize="14" IsChecked="{Binding selectedSort, Converter={StaticResource RadioButtonConverter}, ConverterParameter=По возрастанию}"/>
            <RadioButton Grid.Column="2" Content="По убыванию" HorizontalAlignment="Left" VerticalAlignment="Center" Height="14" Width="160"  FontFamily="Times New Roman" FontSize="14" IsChecked="{Binding selectedSort, Converter={StaticResource RadioButtonConverter}, ConverterParameter=По убыванию}"/>


        </StackPanel>
        <Button Grid.Column="3" Content="Добавить альбом" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"  FontFamily="Times New Roman" Margin="10,5,10,5" Command="{Binding GoAddAlbum}" Visibility="{Binding Converter={StaticResource RoleVisibilityConverter}, ConverterParameter=Admin}"/>





    </Grid>
</Page>
