<Window x:Class="MusicWpf.Views.Album"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MusicWpf.Views"
        mc:Ignorable="d"
        Title="Album" Height="450" Width="800">
    <Grid Background="White">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="19*"/>
            <ColumnDefinition Width="81*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="60*"/>
            <RowDefinition Height="59*"/>
            <RowDefinition Height="57*"/>
            <RowDefinition Height="259*"/>
        </Grid.RowDefinitions>
        <Image HorizontalAlignment="Center" Height="300" VerticalAlignment="Center"  Grid.Column="0" Grid.RowSpan="3" Source="/data/placeholder_cover.png"/>
        <Image HorizontalAlignment="Left" Height="168" VerticalAlignment="Top" Width="160" Grid.RowSpan="3" Source="{Binding Image}" Grid.ColumnSpan="2"/>

        <ListBox ItemsSource="{Binding tracks}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Grid.Row="3" Grid.ColumnSpan="2" HorizontalContentAlignment="Stretch" Margin="0,10,0,0">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <local:AlbumUC/>
                </DataTemplate>
            </ListBox.ItemTemplate>

        </ListBox>


        <TextBlock Grid.Column="1" Text="{Binding namealbum}" FontSize="24" FontFamily="Times New Roman" HorizontalAlignment="Left" Margin="30,0,0,0" TextWrapping="Wrap"  VerticalAlignment="Center" Height="35" Width="456"/>
        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="18" FontFamily="Times New Roman" HorizontalAlignment="Left" Margin="30,0,0,0" Grid.Row="1" TextWrapping="Wrap" VerticalAlignment="Center" Width="456" Height="35"/>
        <TextBlock Grid.Column="1" Text="{Binding genre}" FontFamily="Times New Roman" FontSize="18" HorizontalAlignment="Left" Margin="30,0,0,0" Grid.Row="2" TextWrapping="Wrap" VerticalAlignment="Center" Width="600" Height="35"/>
        <Button Grid.Column="1" Content="Редактировать" HorizontalAlignment="Left" Margin="521,0,0,0" VerticalAlignment="Center" Width="117" Height="30" Background="#FF9C4DFF" FontFamily="Times New Roman" Command="{Binding RedAlbum}" Foreground="White"/>
        <Button Grid.Column="1" Content="Удалить" HorizontalAlignment="Left" Margin="521,13,0,0" Grid.Row="1" VerticalAlignment="Top" Height="30" Width="117" Command="{Binding deleteAlbum}" Foreground="White" Background="#FF9C4DFF" FontFamily="Times New Roman"/>
    </Grid>
</Window>
