<UserControl x:Class="MusicPlus.Views.TracksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1200">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <TextBlock Grid.Column="0"
                       Text="Треки" 
                       FontSize="24" 
                       FontWeight="Bold"
                       VerticalAlignment="Center"/>
            
            <Button Grid.Column="1"
                    Content="+ Добавить трек"
                    Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibilityConverter}}"
                    Click="AddTrack_Click"
                    Background="#5DCC99"
                    Padding="15,8"
                    Margin="10,0,0,0"/>
        </Grid>

        
        <Grid Grid.Row="1" 
              Margin="0,0,0,20"
              Visibility="{Binding IsGuest, Converter={StaticResource InverseBoolConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            
            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                <Label Content="Поиск:" FontSize="12"/>
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Padding="10,8"
                         FontSize="14"/>
            </StackPanel>

            
            <StackPanel Grid.Column="1" Margin="10,0,10,0">
                <Label Content="Жанр:" FontSize="12"/>
                <ComboBox ItemsSource="{Binding Genres}"
                         SelectedItem="{Binding SelectedGenre}"
                         Padding="10,8"/>
            </StackPanel>

            
            <StackPanel Grid.Column="2" Margin="10,0,0,0">
                <Label Content="Сортировка:" FontSize="12"/>
                <ComboBox ItemsSource="{Binding SortOptions}"
                         SelectedItem="{Binding SortOrder}"
                         Padding="10,8"/>
            </StackPanel>
        </Grid>

        
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Tracks}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#FFFFFF"
                                BorderBrush="#E0E0E0"
                                BorderThickness="0,0,0,1"
                                Padding="15,10"
                                Margin="0,5"
                                Cursor="Hand"
                                MouseLeftButtonDown="TrackItem_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding TrackName}" 
                                               FontSize="18" 
                                               FontWeight="Bold"
                                               Margin="0,0,0,5"/>
                                    <TextBlock FontSize="14"
                                               Foreground="#4B4B4B"
                                               TextWrapping="Wrap">
                                        <TextBlock.Text>
                                            <Binding Path="ArtistsText"/>
                                        </TextBlock.Text>
                                    </TextBlock>
                                    
                                    <TextBlock Text="{Binding AlbumTitle}" 
                                               FontSize="12"
                                               Foreground="#4B4B4B"
                                               Margin="0,3,0,0"
                                               Visibility="{Binding AlbumTitle, Converter={StaticResource StringToVisibilityConverter}}"/>
                                </StackPanel>

                                
                                <TextBlock Grid.Column="1" 
                                           VerticalAlignment="Center"
                                           Margin="15,0"
                                           FontFamily="Segoe UI">
                                    <TextBlock.Text>
                                        <Binding Path="Rating" StringFormat="Рейтинг: {0:F1}"/>
                                    </TextBlock.Text>
                                </TextBlock>

                                
                                <TextBlock Grid.Column="2" 
                                           VerticalAlignment="Center"
                                           Margin="15,0"
                                           FontFamily="Segoe UI">
                                    <TextBlock.Text>
                                        <Binding Path="Duration" Converter="{StaticResource DurationToStringConverter}"/>
                                    </TextBlock.Text>
                                </TextBlock>

                                
                                <Button Grid.Column="3"
                                        Content="Редактировать"
                                        Visibility="{Binding DataContext.IsAdmin, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Click="EditTrack_Click"
                                        Margin="15,0,0,0"
                                        Padding="10,5"
                                        Background="#9C4DFF"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
