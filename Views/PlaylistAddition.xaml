<Window x:Class="SpotApp_wpf.Views.PlaylistAddition"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SpotApp_wpf.Views"
        mc:Ignorable="d"
        Title="PlaylistAddition" Height="400" Width="600">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>
        <Border BorderBrush="Black" Background="#EDE2FF" BorderThickness="1" Grid.ColumnSpan="2"/>
        <TextBlock HorizontalAlignment="Center" Grid.ColumnSpan="2" FontSize="25" FontWeight="Bold" TextWrapping="Wrap" Text="Добавление Плейлиста" VerticalAlignment="Center"/>
        <TextBlock HorizontalAlignment="Center" Grid.Row="1" Height="auto" Width="180" FontSize="20" TextWrapping="Wrap" Text="Название:" VerticalAlignment="Center" TextAlignment="Center"/>
        <TextBlock HorizontalAlignment="Center" Grid.Row="2" Height="auto" Width="180" FontSize="20" TextWrapping="Wrap" Text="Описание:" VerticalAlignment="Center" TextAlignment="Center"/>
        <StackPanel Grid.Row="3">
            <TextBlock TextWrapping="Wrap" Text="Список тегов:" FontSize="15" TextAlignment="Center"/>
            <TextBox TextWrapping="Wrap" Text="" FontSize="20" Height="60" IsReadOnly="true"/>
        </StackPanel>
        <StackPanel Grid.Row="4">
            <TextBlock TextWrapping="Wrap" Text="Список композиций:" FontSize="15" TextAlignment="Center"/>
            <TextBox TextWrapping="Wrap" Text="" FontSize="20" Height="60" IsReadOnly="true"/>
        </StackPanel>
        <StackPanel Height="45"  Grid.Column="1" Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center">
            <ComboBox Width="250"/>
            <Button Content="+" Width="50" Margin="15,0,0,0" FontSize="25" FontWeight="Bold" Background="#9c4dff"/>
        </StackPanel>
        <StackPanel Height="45"  Grid.Column="1" Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
            <ComboBox Width="250"/>
            <Button Content="+" Width="50" Margin="15,0,0,0" FontSize="25" FontWeight="Bold" Background="#9c4dff"/>
        </StackPanel>
        <Button Content="Добавить" Grid.ColumnSpan="2" HorizontalAlignment="Center" Grid.Row="7" VerticalAlignment="Center" Height="40" Width="200" FontSize="20"/>

        <TextBox Grid.Column="1" HorizontalAlignment="Center" Grid.Row="1" TextWrapping="Wrap" Text="" VerticalAlignment="Center" Width="320" Height="45" FontSize="25"/>
        <TextBox Grid.Column="1" HorizontalAlignment="Center" Grid.Row="2" TextWrapping="Wrap" Text="" VerticalAlignment="Center" Width="320" Height="45" FontSize="25"/>
    </Grid>
</Window>
