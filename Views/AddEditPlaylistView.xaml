<Window x:Class="MusicPlus.Views.AddEditPlaylistView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d" 
        Title="{Binding Title}" 
        Height="400" 
        Width="500"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="30" Background="#FFFFFF">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" 
                   Text="{Binding Title}" 
                   FontSize="20" 
                   FontWeight="Bold"
                   Margin="0,0,0,20"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                
                <StackPanel Margin="0,0,0,15">
                    <Label Content="Название плейлиста *" FontSize="14"/>
                    <TextBox Text="{Binding PlaylistName, UpdateSourceTrigger=PropertyChanged}" 
                             FontSize="14"
                             Padding="10,8"/>
                </StackPanel>

                
                <StackPanel Margin="0,0,0,15">
                    <Label Content="Описание" FontSize="14"/>
                    <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" 
                             FontSize="14"
                             Padding="10,8"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             Height="100"
                             VerticalScrollBarVisibility="Auto"/>
                </StackPanel>

                
                <StackPanel Margin="0,0,0,15">
                    <Label Content="Теги" FontSize="14"/>
                    <ListBox x:Name="TagsListBox"
                             ItemsSource="{Binding AvailableTags}"
                             SelectionMode="Multiple"
                             Height="150"
                             SelectionChanged="TagsListBox_SelectionChanged"/>
                    <TextBlock Text="Можно выбрать несколько тегов или ввести новый через запятую"
                               FontSize="11"
                               Foreground="#4B4B4B"
                               Margin="0,5,0,0"/>
                    <TextBox x:Name="CustomTagsTextBox"
                             Text="{Binding CustomTagsInput, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="14"
                             Padding="10,8"
                             Margin="0,5,0,0"
                             TextChanged="CustomTagsTextBox_TextChanged"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        
        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">
            <Button Content="Сохранить" 
                    Command="{Binding SaveCommand}"
                    Margin="0,0,10,0"
                    Width="120"/>
            <Button Content="Отмена" 
                    Command="{Binding CancelCommand}"
                    Background="#CC3366"
                    Width="120"/>
        </StackPanel>
    </Grid>
</Window>
