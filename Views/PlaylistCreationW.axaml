<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" 
        d:DesignWidth="650" 
        d:DesignHeight="550"
        Width="650"
        Height="550"
        CanResize="False"
        x:Class="MusicPlusPlus.PlaylistCreationW"
        Title="PlaylistCreationW">

    <Grid
    ShowGridLines="False"
    ColumnDefinitions="*,*"
    RowDefinitions="50,8,32,8,96,8,32,8,225,8,*">
    
        <!--ШАПКА-->
        <StackPanel
        Grid.Row="0"
        Grid.ColumnSpan="2"
        Orientation="Horizontal"
        Background="{DynamicResource ResourceKey=SecondaryBackground}">
			
            <!--заголовок-->
            <TextBlock
            x:Name="TitleTBlock"
            Text="Добавление плейлиста"
            VerticalAlignment="Center"
            HorizontalAlignment="Left"
            Margin="15,0,0,0"
            FontSize="32"
            FontWeight="SemiBold">
            </TextBlock>

        </StackPanel>

        <!--ввод названия-->
            <TextBlock
            Grid.Row="2"
            VerticalAlignment="Center"
            Margin="15,0,0,0"
            Text="Название: "
            FontSize="24">
            </TextBlock>
            <TextBox
            x:Name="NameTB"
            Grid.Row="2"
            Grid.ColumnSpan="2"
            VerticalAlignment="Center"
            HorizontalAlignment="Right"
            Margin="0,0,5,0"
            Width="450">
            </TextBox>

        <!--ввод описания-->
            <TextBlock
            Grid.Row="4"
            VerticalAlignment="Center"
            Margin="15,0,0,0"
            Text="Описание: "
            FontSize="24">
            </TextBlock>
            <TextBox
            x:Name="DescriptionTB"
            Grid.Row="4"
            Grid.ColumnSpan="2"
            VerticalAlignment="Center"
            HorizontalAlignment="Right"
            Margin="0,0,5,0"
            Width="450"
            Height="96"
            TextWrapping="Wrap">
            </TextBox>

        <!--Выбор тегов-->
        <AutoCompleteBox
        x:Name="TagsACB"
        SelectionChanged="TagsACB_SelectionChanged"
        Grid.ColumnSpan="2"
        Grid.Row="6"
        HorizontalAlignment="Left"
        VerticalAlignment="Center"
        Margin="15,0,0,0"
        Width="400"
        Watermark="Тэг...">
        </AutoCompleteBox>

        <!--показ выбранных тегов-->
        <ListBox
        x:Name="SelectedTagsLB"
        Grid.Column="0"
        Grid.Row="8"
        HorizontalAlignment="Left"
        Margin="15,0,0,0"
        Width="400"
        Height="225">
        </ListBox>

        <!--очистка выбора-->
        <StackPanel
        Grid.Column="1"
                Grid.Row="8"
                VerticalAlignment="Center"
                HorizontalAlignment="Right"
                Margin="0,0,5,0"
                Spacing="15"
                Orientation="Vertical">
			
                <Button
                x:Name="TagDeletionB"
                Click="TagDeletionB_Click"
                Width="175"
                Content="Удалить выбранное"
                FontSize="18">
                </Button>

                <Button
                x:Name="ClearSelectionB"
                Click="ClearSelectionB_Click"
                Width="175"
                Content="Очистить выбор"
                FontSize="18">
                </Button>

        </StackPanel>
        
        <!--сохранение-->
        <Button
        x:Name="SaveB"
        Click="SaveB_Click"
        Grid.ColumnSpan="2"
        Grid.Row="10"
        HorizontalAlignment="Center"
        Width="150"
        Content="Сохранить"
        FontSize="22">
        </Button>
    
    </Grid>
  
</Window>
