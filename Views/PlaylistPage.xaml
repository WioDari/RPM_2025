<Page x:Class="SpotApp_wpf.Views.PlaylistPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:SpotApp_wpf.Views"
      Style="{StaticResource page}"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PlaylistPage">

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="11*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="6*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <ListBox ItemsSource="{Binding playlists, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Stretch" SelectedItem="{Binding selectedPlaylist}" Grid.ColumnSpan="2" Grid.Row="2">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <local:PlayListTemplate/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Button Command="{Binding addPlaylistCommand}" Grid.Column="1" Content="Добавить" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Height="30" Width="103"/>
    </Grid>
</Page>
