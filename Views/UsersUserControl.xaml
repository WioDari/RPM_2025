<UserControl x:Class="MusicWpf.Views.UsersUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MusicWpf.Views"
             mc:Ignorable="d" 
             d:DesignHeight="260" d:DesignWidth="800">
    <Grid Background="White"   ShowGridLines="False">

        <Grid.RowDefinitions>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="11*"/>
        </Grid.RowDefinitions>
        <Border BorderBrush="Black" BorderThickness="1" Grid.Row="0" Grid.RowSpan="2" Grid.ColumnSpan="2"/>
        <Border BorderBrush="Black" BorderThickness="1" Grid.Row="0" Grid.RowSpan="1" Grid.ColumnSpan="2"/>
        <TextBlock HorizontalAlignment="Left" TextWrapping="Wrap" Text="{Binding fio}" VerticalAlignment="Center" Height="40" Width="590" FontSize="20" Margin="10,0,0,0" FontFamily="Times New Roman"/>
        <TextBlock HorizontalAlignment="Center" Grid.Row="1" TextWrapping="Wrap" Text="{Binding login}" VerticalAlignment="Top" Height="37" Width="580" FontSize="16" FontFamily="Times New Roman"/>
        <TextBlock HorizontalAlignment="Center" Grid.Row="1" TextWrapping="Wrap" Text="{Binding email}" VerticalAlignment="Top" Height="37" Width="580" FontSize="16" Margin="0,38,0,0" FontFamily="Times New Roman"/>
        <TextBlock HorizontalAlignment="Center" Grid.Row="1" TextWrapping="Wrap" Text="{Binding role}" VerticalAlignment="Top" Height="37" Width="580" FontSize="16" Margin="0,75,0,0" FontFamily="Times New Roman"/>
        <TextBlock HorizontalAlignment="Center" Grid.Row="1" TextWrapping="Wrap" Text="{Binding status}" VerticalAlignment="Top" Height="37" Width="580" FontSize="16" Margin="0,112,0,0" FontFamily="Times New Roman"/>
        <TextBlock HorizontalAlignment="Center" Grid.Row="1" TextWrapping="Wrap" Text="{Binding dataregist}" VerticalAlignment="Top" Height="37" Width="580" FontSize="16" FontFamily="Times New Roman" Margin="0,150,0,0"/>


    </Grid>
</UserControl>
