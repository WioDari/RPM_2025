<Window x:Class="SpotApp_wpf.Views.PlaylistDetails"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SpotApp_wpf.Views"
        mc:Ignorable="d"
        Style="{StaticResource window}"
        Title="PlaylistDetails" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="165"/>
            <RowDefinition Height="3*"/>
        </Grid.RowDefinitions>
        <TextBlock HorizontalAlignment="Left" Margin="10,10,0,0" TextWrapping="Wrap" Text="{Binding playlistName}" VerticalAlignment="Top" Height="28" Width="620" FontSize="22" FontWeight="Bold"/>
        <TextBlock HorizontalAlignment="Left" Margin="10,39,0,0" TextWrapping="Wrap" Text="{Binding creationDate, StringFormat=Дата создания: {0}}" VerticalAlignment="Top" Height="28" Width="620" FontSize="20"/>
        <TextBlock HorizontalAlignment="Left" Margin="10,67,0,0" TextWrapping="Wrap" Text="{Binding likes, StringFormat=Лайки: {0}}" VerticalAlignment="Top" Height="28" Width="620" FontSize="20"/>
        <TextBlock HorizontalAlignment="Left" Margin="10,95,0,0" TextWrapping="Wrap" Text="{Binding duration, StringFormat=Продолжительность: {0}}" VerticalAlignment="Top" Height="28" Width="620" FontSize="20"/>
        <TextBlock HorizontalAlignment="Left" Margin="10,123,0,0" TextWrapping="Wrap" Text="{Binding tags, StringFormat=Теги: {0}}" VerticalAlignment="Top" Height="auto" Width="615" FontSize="20"/>
        <ListBox Grid.Row="1" Grid.ColumnSpan="2" HorizontalContentAlignment="Stretch" ItemsSource="{Binding plDetails}"  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <local:TrackDetailsTemplate/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top">
            <Button Height="40" Width="100" Content="Редактировать" Command="{Binding editPlaylistCommand}" FontSize="15"/>
            <Button Height="40" Width="100" Content="Удалить" Background="#cc3366" Command="{Binding deletePlaylistCommand}" FontSize="15"/>
        </StackPanel>
    </Grid>
</Window>
