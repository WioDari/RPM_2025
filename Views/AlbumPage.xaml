<Page x:Class="MusicWpf.Views.AlbumPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MusicWpf.Views"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      
      Title="AlbumPage">
    <Grid Background="White" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="299*"/>
            <ColumnDefinition Width="140*"/>
            <ColumnDefinition Width="149*"/>
            <ColumnDefinition Width="212*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MinHeight="58"/>
            <RowDefinition/>
        </Grid.RowDefinitions>



        <ListBox Grid.Row="1" ItemsSource="{Binding albums}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectedItem="{Binding selectedAlbim}" Grid.ColumnSpan="4">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <local:AlbumUserControl/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBox HorizontalAlignment="Left" TextWrapping="Wrap" Text="{Binding searchText, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Width="210" Height="20" Margin="58,0,0,0"/>
        <ComboBox HorizontalAlignment="Center" VerticalAlignment="Center" Width="108" Height="20" ItemsSource="{Binding genres}" SelectedItem="{Binding selectedGenres}" Grid.Column="1"/>
        <RadioButton Content="По возврастанию" HorizontalAlignment="Center" Margin="0,11,0,0" VerticalAlignment="Top" Grid.Column="2" Height="14" Width="141" FontSize="15" FontFamily="Times New Roman"/>
        <RadioButton Content="По убыванию" HorizontalAlignment="Left" Margin="4,30,0,0" VerticalAlignment="Top" Grid.Column="2" Height="19" Width="134" FontSize="15" FontFamily="Times New Roman"/>
        <TextBlock HorizontalAlignment="Left" Margin="10,0,0,0" TextWrapping="Wrap" Text="Поиск" VerticalAlignment="Center" FontFamily="Times New Roman" FontSize="16" Height="18" Width="43" />
        <Button Grid.Column="3" Content="Создание альбомов" HorizontalAlignment="Center" VerticalAlignment="Center" Width="154" Height="20" Background="#FF9C4DFF" FontFamily="Times New Roman" Command="{Binding AddAlbumCommand}" Foreground="White"/>

    </Grid>


</Page>
