<Page x:Class="MusicWpf.Views.AlbumPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MusicWpf.Views"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      
      Title="AlbumPage">
    <Grid Background="White" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="427*"/>
            <ColumnDefinition Width="206*"/>
            <ColumnDefinition Width="167*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MinHeight="49"/>
            <RowDefinition/>
        </Grid.RowDefinitions>



        <ListBox Grid.Row="1" ItemsSource="{Binding albums}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectedItem="{Binding selectedAlbim}" Grid.ColumnSpan="3">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <local:AlbumUserControl/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBox HorizontalAlignment="Left" TextWrapping="Wrap" Text="{Binding searchText, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Width="250" Height="20" Margin="79,0,0,0"/>
        <ComboBox HorizontalAlignment="Center" VerticalAlignment="Center" Width="122" Grid.Column="1" Height="20" ItemsSource="{Binding genres}" SelectedItem="{Binding selectedGenres}"/>
        <RadioButton Content="По возврастанию" HorizontalAlignment="Center" Margin="0,9,0,0" VerticalAlignment="Top" Grid.Column="2" Height="14" Width="134" FontSize="16" FontFamily="Times New Roman"/>
        <RadioButton Content="По убыванию" HorizontalAlignment="Center" Margin="0,30,0,0" VerticalAlignment="Top" Grid.Column="2" Height="14" Width="134" FontSize="16" FontFamily="Times New Roman"/>
        <TextBlock HorizontalAlignment="Left" Margin="10,0,0,0" TextWrapping="Wrap" Text="Поиск" VerticalAlignment="Center" FontFamily="Times New Roman" FontSize="16" />
    </Grid>


</Page>
