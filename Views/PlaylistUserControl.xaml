<UserControl x:Class="MusicWpf.Views.PlaylistUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MusicWpf.Views"
             mc:Ignorable="d" 
             d:DesignHeight="250" d:DesignWidth="800" Height="250" Width="Auto">
    <Grid Background="White"  ScrollViewer.HorizontalScrollBarVisibility="Disabled" ShowGridLines="False">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="79*"/>
            <ColumnDefinition Width="21*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="63*"/>
            <RowDefinition Height="40*"/>
            <RowDefinition Height="40*"/>
            <RowDefinition Height="40*"/>
            <RowDefinition Height="40*"/>

        </Grid.RowDefinitions>
        <Border BorderBrush="Black" BorderThickness="1" Grid.Row="0" Grid.RowSpan="6" Grid.ColumnSpan="2"/>
        <Border BorderBrush="Black" BorderThickness="1" Grid.Row="0" Grid.RowSpan="1" Grid.ColumnSpan="2"/>
        <TextBlock HorizontalAlignment="Left" TextWrapping="Wrap" Text="{Binding title}" VerticalAlignment="Center" Height="40" Width="780" FontSize="20" Grid.ColumnSpan="2" Margin="10,0,0,0" FontFamily="Times New Roman"/>
        <TextBlock HorizontalAlignment="Left" Grid.Row="1" TextWrapping="Wrap" Text="{Binding likes}" VerticalAlignment="Center" Height="38" Width="580" FontSize="16" FontFamily="Times New Roman"/>
        <TextBlock HorizontalAlignment="Left" Grid.Row="2" TextWrapping="Wrap" Text="{Binding subs}" VerticalAlignment="Top" Height="38" Width="580" FontSize="16" FontFamily="Times New Roman" Grid.RowSpan="2"/>
        <TextBlock HorizontalAlignment="Left" Grid.Row="3" TextWrapping="Wrap" Text="{Binding tracksCount}" VerticalAlignment="Top" Height="36" Width="580" FontSize="16" Margin="0,6,0,0" FontFamily="Times New Roman"/>
        <TextBlock HorizontalAlignment="Left" Grid.Row="4" TextWrapping="Wrap" Text="{Binding creationDate}" VerticalAlignment="Top" Height="38" Width="580" FontSize="16" Margin="0,2,0,0" FontFamily="Times New Roman"/>
        <TextBlock Grid.Column="1" HorizontalAlignment="Center" Grid.Row="1" TextWrapping="Wrap" Text="{Binding time}" VerticalAlignment="Top" Height="88" Width="114" FontSize="25" TextAlignment="Center" Margin="0,44,0,0" Grid.RowSpan="3"/>

    </Grid>
</UserControl>
