<Page x:Class="Spotify_wpf.Views.TrackList"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Spotify_wpf.Views"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="TrackList">

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="17*"/>
            <RowDefinition Height="133*"/>
        </Grid.RowDefinitions>
        <ListBox ItemsSource="{Binding trackLists}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch"  Margin="0,12,0,0" Grid.Row="1" SelectedItem="{Binding selectedTrack}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <local:TrackListUC/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Button Content="Добавить трек" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10" Command="{Binding GoTrack}" FontFamily="Times New Roman" Height="20" Width="100" Visibility="{Binding Converter={StaticResource RoleVisibilityConverter}, ConverterParameter=Admin}"/>
        <Button Content="Удалить трек" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="120,0,0,0" Command="{Binding DeleteTrackCommand}" FontFamily="Times New Roman" Height="20" Width="100" Visibility="{Binding Converter={StaticResource RoleVisibilityConverter}, ConverterParameter=Admin}"/>

    </Grid>


</Page>
