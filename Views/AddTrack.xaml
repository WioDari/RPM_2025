<Window x:Class="Spotify_wpf.Views.AddTrack"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Spotify_wpf.Views"
        mc:Ignorable="d"
        Style="{StaticResource Window}"
        Title="AddTrack" Height="400" Width="500">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="37*"/>
            <RowDefinition Height="22*"/>
            <RowDefinition Height="37*"/>
            <RowDefinition Height="22*"/>
            <RowDefinition Height="29*"/>
            <RowDefinition Height="45*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150*"/>
            <ColumnDefinition Width="150*"/>

            <ColumnDefinition Width="150*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="1" Grid.ColumnSpan="2" Margin="5,5,5,5" Grid.Row="1">
            <TextBlock TextWrapping="Wrap" Text="Название трека"/>
            <TextBox TextWrapping="Wrap" Text="TextBox"/>
        </StackPanel>
        <Border Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="3" Background="#FFEDE2FF">
            <Border BorderBrush="#7A00CC" BorderThickness="1.5"/>
        </Border>

        <Image Source="/Resources/placeholder_cover.png" HorizontalAlignment="Center" VerticalAlignment="Center" Width="100" Grid.Row="2" Height="100"/>
        <Image HorizontalAlignment="Left" Height="100"  Grid.RowSpan="2" Grid.Row="1" VerticalAlignment="Top" Width="100" Margin="10,10,0,0"/>





        <StackPanel Grid.Column="1" Grid.Row="4" Margin="0,3,0,0" Grid.ColumnSpan="1"/>
        <StackPanel Grid.Column="1" Grid.Row="4" Grid.ColumnSpan="1" Margin="5,5,5,5">
            <TextBlock TextWrapping="Wrap" Text="Битрейт"/>
            <TextBox TextWrapping="Wrap" Text="TextBox"/>
        </StackPanel>
        <StackPanel Grid.Column="2" Grid.Row="4" Margin="5,5,5,5">
            <TextBlock TextWrapping="Wrap" Text="Рейтинг"/>
            <TextBox TextWrapping="Wrap" Text="TextBox"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Grid.Row="3" Grid.ColumnSpan="1" Margin="5,5,5,5">
            <TextBlock TextWrapping="Wrap" Text="Выбор альбома:"/>
            <ComboBox />
        </StackPanel>
        <StackPanel Grid.Column="2" Grid.Row="3" Margin="5,5,5,5">
            <TextBlock TextWrapping="Wrap" Text="Продолжительность трека:"/>
            <TextBox TextWrapping="Wrap" Text="TextBox"/>

        </StackPanel>
        <StackPanel Grid.Column="1" Grid.Row="2" Grid.ColumnSpan="1" Grid.RowSpan="1" Margin="5,5,5,5">
            <TextBlock TextWrapping="Wrap" Text="Выбор исполнителей:"/>
            <ComboBox />
            <Button Content="Добавить исполнителя"/>

        </StackPanel>
        <StackPanel Grid.Column="2" Grid.Row="2" Grid.RowSpan="1" Margin="5,5,5,5">
            <TextBlock TextWrapping="Wrap" Text="Выбранные исполнители:"/>
            <TextBlock TextWrapping="Wrap" Text=""/>

        </StackPanel>
        <Button Content="Добавить обложку" HorizontalAlignment="Center"  Grid.Row="3" VerticalAlignment="Center" Height="18" Width="100"/>
        <StackPanel Grid.Row="4" Grid.RowSpan="1" Margin="5,5,5,5">
            <TextBlock TextWrapping="Wrap" Text="Выбор даты выпуска: "/>
            <DatePicker/>

        </StackPanel>
        <Button Grid.Column="1" Content="Сохранить и выйти" HorizontalAlignment="Center" Grid.Row="4" VerticalAlignment="Top" Height="28" Margin="0,58,0,0" Grid.RowSpan="2" Width="150"/>
        <TextBlock Grid.Column="1" HorizontalAlignment="Center" TextWrapping="Wrap" Text="Добавление треков" VerticalAlignment="Center" FontWeight="Bold" TextAlignment="Center" FontSize="20" Height="46" Width="147"/>



    </Grid>
</Window>
