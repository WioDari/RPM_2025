<Window x:Class="MusicWpf.Views.AddTrack"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MusicWpf.Views"
        mc:Ignorable="d"
        Style="{StaticResource GlobalWindowStyle}"
        Title="AddTrack" Height="450" Width="600">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="57*"/>
            <RowDefinition Height="67*"/>
            <RowDefinition Height="64*"/>
            <RowDefinition Height="67*"/>
            <RowDefinition Height="66*"/>
            <RowDefinition Height="115*"/>
        </Grid.RowDefinitions>
        <Border BorderBrush="Black" BorderThickness="1" Background="#FF7A00CC" Margin="0,0,0,67" Grid.RowSpan="2" Grid.ColumnSpan="2"/>
        <TextBlock HorizontalAlignment="Left" TextWrapping="Wrap" Text="Создание треков" VerticalAlignment="Center" Foreground="White" FontSize="22" Height="26" Width="156" Grid.ColumnSpan="2" Margin="222,0,0,0"/>
        <TextBlock HorizontalAlignment="Left" Margin="24,15,0,0" Grid.Row="1" TextWrapping="Wrap" Text="Введите название трека" VerticalAlignment="Top" Height="18" Width="223"/>
        <TextBlock HorizontalAlignment="Left" Margin="74,0,0,0" Grid.Row="2" TextWrapping="Wrap" Text="" VerticalAlignment="Center" Height="18" Width="0"/>
        <ComboBox HorizontalAlignment="Left" Margin="55,27,0,0" Grid.Row="4" VerticalAlignment="Top" Width="120" Height="24"/>
        <ComboBox HorizontalAlignment="Center" Margin="0,27,0,0" Grid.Row="4" VerticalAlignment="Top" Width="120" Height="24" Grid.Column="1"/>
        <TextBox HorizontalAlignment="Left" Margin="24,38,0,0" Grid.Row="1" TextWrapping="Wrap" Text="{Binding NameTrack}" VerticalAlignment="Top" Width="263" Height="20"/>
        <TextBox HorizontalAlignment="Left" Margin="24,34,0,0" Grid.Row="2" TextWrapping="Wrap" Text="{Binding ProdolTrack}" VerticalAlignment="Top" Width="263" Height="20"/>
        <TextBlock HorizontalAlignment="Left" Margin="24,10,0,0" Grid.Row="2" TextWrapping="Wrap" Text="Введите продолжительость трека" VerticalAlignment="Top" Height="18" Width="228"/>
        <TextBox HorizontalAlignment="Left" Margin="24,29,0,0" Grid.Row="3" TextWrapping="Wrap" Text="{Binding Bitret}" VerticalAlignment="Top" Width="166" Height="20"/>
        <TextBlock HorizontalAlignment="Left" Margin="24,5,0,0" Grid.Row="3" TextWrapping="Wrap" Text="Введите битрейт" VerticalAlignment="Top" Height="18" Width="182"/>
        <TextBlock Grid.Column="1" HorizontalAlignment="Left" Margin="30,5,0,0" Grid.Row="3" TextWrapping="Wrap" Text="Введите рейтин" VerticalAlignment="Top" Width="187" Height="18"/>
        <TextBox Grid.Column="1" HorizontalAlignment="Left" Margin="30,27,0,0" Grid.Row="3" TextWrapping="Wrap" Text="{Binding Reiting}" VerticalAlignment="Top" Width="172" Height="20"/>

    </Grid>
</Window>
