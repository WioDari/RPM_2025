<Window x:Class="MusicPlus.Views.AuthView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Вход в систему" 
        Height="700" 
        Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid Background="#FFFFFF" Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        
        <StackPanel Grid.Row="0" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Center"
                    Margin="0,0,0,30">
            <Image x:Name="LogoImage"
                   Width="50" 
                   Height="50" 
                   Margin="0,0,15,0"
                   Loaded="LogoImage_Loaded"/>
            <TextBlock Text="Музыка+" 
                       FontSize="32" 
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       Foreground="#7A00CC"/>
        </StackPanel>

        
        <Label Grid.Row="1" Content="Логин:" Margin="0,0,0,5"/>
        <TextBox Grid.Row="2" 
                 Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,0,0,15"/>

        
        <Label Grid.Row="3" Content="Пароль:" Margin="0,0,0,5"/>
        <PasswordBox x:Name="PasswordBox" 
                     Grid.Row="4"
                     PasswordChanged="PasswordBox_PasswordChanged"
                     Margin="0,0,0,15"/>

        
        <Label Grid.Row="5" Content="Введите текст с изображения:" Margin="0,0,0,5"/>
        <Grid Grid.Row="6" Margin="0,0,0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Image Grid.Column="0" 
                   Source="{Binding CaptchaImage}" 
                   Width="200" 
                   Height="80"
                   Stretch="Uniform"
                   Margin="0,0,10,0"/>
            <Button Grid.Column="1" 
                    Content="Обновить" 
                    Command="{Binding RefreshCaptchaCommand}"
                    VerticalAlignment="Center"
                    Padding="10,5"/>
        </Grid>
        <TextBox Grid.Row="7" 
                 Text="{Binding CaptchaInput, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,0,0,15"/>

        
        <TextBlock Grid.Row="8" 
                   Text="{Binding ErrorMessage}" 
                   Foreground="#CC3366"
                   TextWrapping="Wrap"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"
                   Margin="0,0,0,15"/>

        
        <StackPanel Grid.Row="9" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
            <Button Content="Войти" 
                    Command="{Binding LoginCommand}"
                    Margin="0,0,10,0"
                    Width="120"
                    Height="35"/>
            <Button Content="Гость" 
                    Command="{Binding GuestModeCommand}"
                    Background="#9C4DFF"
                    Width="120"
                    Height="35"/>
        </StackPanel>
    </Grid>
</Window>
