<Page x:Class="Spotify_wpf.Views.Playlist"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Spotify_wpf.Views"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Playlist">

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="4*"/>
            <RowDefinition Height="41*"/>
        </Grid.RowDefinitions>
        <ListBox ItemsSource="{Binding playlists}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" SelectedItem="{Binding selectedPlaylist}" Margin="0,3,0,0" Grid.Row="1">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <local:PlaylistUserController/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Button Content="Добавить плейлист" Grid.Column="1" Grid.Row="0" Margin="5" Width="150" HorizontalAlignment="Left" Command="{Binding AddPlaylistCommand}"/>

    </Grid>
</Page>
