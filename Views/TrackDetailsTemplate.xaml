<UserControl x:Class="SpotApp_wpf.Views.TrackDetailsTemplate"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SpotApp_wpf.Views"
             mc:Ignorable="d" 
             d:DesignHeight="110" d:DesignWidth="800"
             Height="110">
    <Grid Background="White" ShowGridLines="False">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Border BorderBrush="Black" BorderThickness="1" Grid.RowSpan="2" Grid.ColumnSpan="4"/>
        <TextBlock HorizontalAlignment="Center" Height="auto" Width="300" TextWrapping="Wrap" Text="{Binding trackName}" VerticalAlignment="Center" FontSize="20" FontWeight="Bold"/>
        <TextBlock HorizontalAlignment="Center" Height="auto" Width="300" TextWrapping="Wrap" Text="{Binding authorsl}" VerticalAlignment="Center" Grid.Row="1" FontSize="16"/>
        <TextBlock HorizontalAlignment="Center" Height="auto" Width="150" TextWrapping="Wrap" Text="{Binding listenersCount}" VerticalAlignment="Center" Grid.Column="1" Grid.RowSpan="2" FontSize="16" TextAlignment="Center"/>
        <TextBlock HorizontalAlignment="Center" Height="auto" Width="150" TextWrapping="Wrap" Text="{Binding rating}" VerticalAlignment="Center" Grid.Column="2" Grid.RowSpan="2" FontSize="16" TextAlignment="Center"/>
        <TextBlock HorizontalAlignment="Center" Height="auto" Width="150" TextWrapping="Wrap" Text="{Binding duration}" VerticalAlignment="Center" Grid.Column="3" Grid.RowSpan="2" FontSize="16" TextAlignment="Center"/>

    </Grid>
</UserControl>
