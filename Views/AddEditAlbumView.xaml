<Window x:Class="MusicPlus.Views.AddEditAlbumView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:MusicPlus.Converters"
        mc:Ignorable="d" 
        Title="{Binding Title}" 
        Height="650" 
        Width="700"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="30" Background="#FFFFFF">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" 
                   Text="{Binding Title}" 
                   FontSize="20" 
                   FontWeight="Bold"
                   Margin="0,0,0,20"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                
                <StackPanel Margin="0,0,0,15">
                    <Label Content="Название альбома *" FontSize="14"/>
                    <TextBox Text="{Binding AlbumTitle, UpdateSourceTrigger=PropertyChanged}" 
                             FontSize="14"
                             Padding="10,8"/>
                </StackPanel>

                
                <StackPanel Margin="0,0,0,15">
                    <Label Content="Год выпуска *" FontSize="14"/>
                    <TextBox FontSize="14"
                             Padding="10,8">
                        <TextBox.Text>
                            <Binding Path="ReleaseYear" UpdateSourceTrigger="PropertyChanged" Converter="{StaticResource NullableIntConverter}"/>
                        </TextBox.Text>
                    </TextBox>
                </StackPanel>

                
                <StackPanel Margin="0,0,0,15">
                    <Label Content="Исполнитель *" FontSize="14"/>
                    <ComboBox ItemsSource="{Binding Artists}"
                              SelectedItem="{Binding SelectedArtist}"
                              DisplayMemberPath="ArtistName"
                              Padding="10,8"
                              FontSize="14"/>
                </StackPanel>

                
                <StackPanel Margin="0,0,0,15">
                    <Label Content="Жанры" FontSize="14"/>
                    <ListBox x:Name="GenresListBox"
                             ItemsSource="{Binding AllGenres}"
                             SelectionMode="Multiple"
                             Height="150"
                             DisplayMemberPath="GenreName"
                             SelectionChanged="GenresListBox_SelectionChanged"/>
                </StackPanel>

                
                <StackPanel Margin="0,0,0,15">
                    <Label Content="Обложка альбома" FontSize="14"/>
                    
                    
                    <Border Background="#EDE2FF" 
                            CornerRadius="8" 
                            Padding="10"
                            Margin="0,10,0,10"
                            Visibility="{Binding CoverImage, Converter={StaticResource ObjectToVisibilityConverter}}">
                        <Image Source="{Binding CoverImage}" 
                               Width="200" 
                               Height="200"
                               Stretch="Uniform"/>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Загрузить из файла (PNG, макс. 1000x1000)"
                                Command="{Binding LoadCoverFromFileCommand}"
                                Margin="0,0,10,0"
                                Padding="10,8"/>
                        <Button Content="Указать URL"
                                Command="{Binding ApplyUrlCommand}"
                                Padding="10,8"/>
                    </StackPanel>

                    
                    <TextBox Text="{Binding CoverUrlInput, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="14"
                             Padding="10,8"
                             Margin="0,10,0,0">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="Tag" Value="Введите URL обложки..."/>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        
        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">
            <Button Content="Сохранить" 
                    Command="{Binding SaveCommand}"
                    Background="#5DCC99"
                    Padding="20,10"
                    Margin="0,0,10,0"/>
            <Button Content="Отмена" 
                    Command="{Binding CancelCommand}"
                    Background="#CC3366"
                    Padding="20,10"/>
        </StackPanel>
    </Grid>
</Window>
