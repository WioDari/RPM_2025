<Window x:Class="Spotify_wpf.Views.AddAlbum"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Spotify_wpf.Views"
        mc:Ignorable="d"
        Style="{StaticResource Window}"
        Title="AddAlbum" Height="400" Width="500">
    <Grid Background="White">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="193*"/>
            <ColumnDefinition Width="168*"/>
            <ColumnDefinition Width="139*"/>

        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="69*"/>
            <RowDefinition Height="48*"/>
            <RowDefinition Height="54*"/>
            <RowDefinition Height="35*"/>
            <RowDefinition Height="71*"/>
            <RowDefinition Height="67*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Image Grid.Row="1" Source="/Resources/placeholder_cover.png" Grid.RowSpan="3" Margin="10,10,10,10"/>
        <Image Grid.Row="1" Source="{Binding imagePath}" Grid.RowSpan="3" Margin="10,10,10,10"/>
        <Button Content="Загрузить обложку" HorizontalAlignment="Center" Grid.Row="4" VerticalAlignment="Center" FontSize="16" FontWeight="Bold" Height="27" Width="174" Command="{Binding AddImageCommand}"/>
        <Border HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="3" Background="#FFEDE2FF"/>
        <Border HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Grid.Column="0" Grid.Row="5" Grid.ColumnSpan="3" Background="#FFEDE2FF"/>
        <Border BorderBrush="#7A00CC" BorderThickness="1" Grid.Row="1" Grid.RowSpan="3"/>
        <Border BorderBrush="#7A00CC" BorderThickness="1" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="4"/>
        <Border BorderBrush="#7A00CC" BorderThickness="1" Grid.Row="4"/>

        <ComboBox SelectedIndex="0" Grid.Column="1"  Grid.Row="3" Margin="10,5,10,5" Grid.ColumnSpan="2" ItemsSource="{Binding artists}" SelectedItem="{Binding selectedArtist}"/>

        <ComboBox Grid.Column="1" Grid.ColumnSpan="1" Grid.Row="4" Margin="10,10,10,0" VerticalAlignment="Top" ItemsSource="{Binding genres}" SelectedItem="{Binding selectedGenre}" SelectedIndex="0"/>
        <TextBlock Grid.Column="2" HorizontalAlignment="Center" Grid.Row="4" TextWrapping="Wrap" VerticalAlignment="Center" Height="Auto" Width="100" Text="{Binding chooseGenre,  UpdateSourceTrigger=PropertyChanged}"/>
        <Button Grid.Column="1" Content="Добавить жанр" Grid.Row="4" VerticalAlignment="Top" HorizontalAlignment="Center" FontSize="16" Height="20" Width="148"  Margin="0,33,0,0" Command="{Binding AddGenre}"/>
        <TextBlock HorizontalAlignment="Left" TextWrapping="Wrap" Text="{Binding Title}" VerticalAlignment="Center" FontSize="20" FontWeight="Bold" TextAlignment="Center"  Grid.ColumnSpan="2" Grid.Column="0" Margin="157,0,0,0"/>
        <Button Grid.Column="1" Content="Сохранить и выйти" HorizontalAlignment="Center"  Grid.Row="5" VerticalAlignment="Center" FontSize="18" Background="#FF5DCC99" Foreground="White" Height="23" Width="148" Command="{Binding SaveAlbumCommand}"/>
        <StackPanel Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="2" Margin="10,5,10,5">
            <TextBlock Text="Название альбома" FontSize="18"/>
            <Border BorderBrush="#7A00CC" BorderThickness="1" />
            <TextBox Grid.Column="1" TextWrapping="Wrap" Grid.Row="1" Grid.ColumnSpan="2" Height="Auto" MinHeight="20" Text="{Binding nameAlbum}"/>
            <Border BorderBrush="Black" BorderThickness="1" Height="1"/>

        </StackPanel>
        <StackPanel Grid.Column="1" Grid.Row="2" Grid.ColumnSpan="2" Margin="10,5,10,5">
            <TextBlock Text="Дата выпуска" FontSize="18"/>
            <Border BorderBrush="#7A00CC" BorderThickness="1" />
            <!--
            <DatePicker Grid.Column="1" Grid.Row="2" Grid.ColumnSpan="2" SelectedDate="{Binding releaseDate}"/> -->
            <Border BorderBrush="Black" BorderThickness="1" Height="1"/>
            <TextBox TextWrapping="Wrap" Text="{Binding releaseYears}" Grid.Column="1" Grid.Row="2" Grid.ColumnSpan="2"/>
        </StackPanel>
       



    </Grid>
</Window>
