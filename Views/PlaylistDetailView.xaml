<Window x:Class="MusicPlus.Views.PlaylistDetailView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d" 
        Title="Детали плейлиста" 
        Height="700" 
        Width="900"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="30" Background="#FFFFFF">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <TextBlock Grid.Column="0" 
                       FontSize="24" 
                       FontWeight="Bold"
                       VerticalAlignment="Center">
                <TextBlock.Text>
                    <Binding Path="PlaylistName" StringFormat="Плейлист: {0}"/>
                </TextBlock.Text>
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPremium}" Value="True">
                                <Setter Property="Foreground" Value="#ff943d"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="+ Добавить трек"
                        Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibilityConverter}}"
                        Click="AddTrack_Click"
                        Background="#5DCC99"
                        Margin="5,0"/>
                <Button Content="Редактировать"
                        Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibilityConverter}}"
                        Click="EditPlaylist_Click"
                        Margin="5,0"/>
                <Button Content="Назад"
                        Click="Back_Click"
                        Margin="5,0"/>
            </StackPanel>
        </Grid>

        
        <Border Grid.Row="1" 
                Background="#EDE2FF" 
                CornerRadius="8" 
                Padding="20"
                Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Создатель:" 
                               FontSize="14" 
                               Foreground="#4B4B4B"
                               Margin="0,0,0,5"/>
                    <TextBlock Text="{Binding CreatorName}" 
                               FontSize="18" 
                               FontWeight="Bold"
                               Margin="0,0,0,15"/>

                    <TextBlock Text="Дата создания:" 
                               FontSize="14" 
                               Foreground="#4B4B4B"
                               Margin="0,0,0,5"/>
                    <TextBlock FontSize="16"
                               Margin="0,0,0,15">
                        <TextBlock.Text>
                            <Binding Path="DateCreated" StringFormat="{}{0:dd.MM.yyyy}"/>
                        </TextBlock.Text>
                    </TextBlock>

                    <TextBlock Text="Лайки:" 
                               FontSize="14" 
                               Foreground="#4B4B4B"
                               Margin="0,0,0,5"/>
                    <TextBlock Text="{Binding Likes}" 
                               FontSize="16"
                               Margin="0,0,0,15"/>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="Описание:" 
                               FontSize="14" 
                               Foreground="#4B4B4B"
                               Margin="0,0,0,5"/>
                    <TextBlock FontSize="14"
                               TextWrapping="Wrap"
                               Margin="0,0,0,15">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{Binding Description}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Description}" Value="">
                                        <Setter Property="Text" Value="Описание отсутствует"/>
                                        <Setter Property="Foreground" Value="#4B4B4B"/>
                                        <Setter Property="FontStyle" Value="Italic"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Description}" Value="{x:Null}">
                                        <Setter Property="Text" Value="Описание отсутствует"/>
                                        <Setter Property="Foreground" Value="#4B4B4B"/>
                                        <Setter Property="FontStyle" Value="Italic"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Text="Теги:" 
                               FontSize="14" 
                               Foreground="#4B4B4B"
                               Margin="0,0,0,5"/>
                    <TextBlock Text="{Binding TagsText}" 
                               FontSize="14"
                               TextWrapping="Wrap"
                               Margin="0,0,0,15"/>

                    <TextBlock Text="Количество треков:" 
                               FontSize="14" 
                               Foreground="#4B4B4B"
                               Margin="0,0,0,5"/>
                    <TextBlock Text="{Binding TrackCount}" 
                               FontSize="16"
                               FontFamily="Segoe UI"
                               Margin="0,0,0,15">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TrackCount}" Value="0">
                                        <Setter Property="Foreground" Value="#CC3366"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Text="Общая продолжительность:" 
                               FontSize="14" 
                               Foreground="#4B4B4B"
                               Margin="0,0,0,5"/>
                    <TextBlock FontSize="16"
                               FontFamily="Segoe UI">
                        <TextBlock.Text>
                            <Binding Path="TotalDuration" Converter="{StaticResource DurationToStringConverter}"/>
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        
        <Border Grid.Row="2" 
                BorderBrush="#E0E0E0" 
                BorderThickness="1" 
                CornerRadius="8"
                Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Треки:" 
                               FontSize="18" 
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="1"
                            Content="Удалить"
                            Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibilityConverter}}"
                            Click="DeleteSelectedTrack_Click"
                            Background="#CC3366"
                            Padding="10,5"
                            Margin="10,0,0,0"/>
                </Grid>

                <ListView Grid.Row="1" 
                          ItemsSource="{Binding Tracks}"
                          SelectedItem="{Binding SelectedTrack, Mode=TwoWay}"
                          BorderThickness="0"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#FFFFFF"
                                    BorderBrush="#E0E0E0"
                                    BorderThickness="0,0,0,1"
                                    Padding="10,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    
                                    <Image Grid.Column="0"
                                           x:Name="TrackCoverImage"
                                           Width="128"
                                           Height="128"
                                           Stretch="Uniform"
                                           Margin="0,0,15,0"
                                           Loaded="TrackCoverImage_Loaded"/>

                                    
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding TrackName}" 
                                                   FontSize="18" 
                                                   FontWeight="Bold"
                                                   Margin="0,0,0,5"/>
                                        <TextBlock FontSize="14"
                                                   Foreground="#4B4B4B"
                                                   TextWrapping="Wrap">
                                            <TextBlock.Text>
                                                <Binding Path="ArtistsText"/>
                                            </TextBlock.Text>
                                        </TextBlock>
                                        
                                        <TextBlock Text="{Binding AlbumTitle}" 
                                                   FontSize="14"
                                                   Foreground="#4B4B4B"
                                                   Margin="0,5,0,0"/>
                                    </StackPanel>

                                    
                                    <TextBlock Grid.Column="2" 
                                               VerticalAlignment="Center"
                                               Margin="15,0"
                                               FontFamily="Segoe UI">
                                        <TextBlock.Text>
                                            <Binding Path="Rating" StringFormat="Рейтинг: {0:F1}"/>
                                        </TextBlock.Text>
                                    </TextBlock>

                                    
                                    <TextBlock Grid.Column="3" 
                                               VerticalAlignment="Center"
                                               FontFamily="Segoe UI">
                                        <TextBlock.Text>
                                            <Binding Path="Duration" Converter="{StaticResource DurationToStringConverter}"/>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</Window>
