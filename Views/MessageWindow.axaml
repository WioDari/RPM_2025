<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" 
        d:DesignWidth="400" 
        d:DesignHeight="300"
        Width="400"
        Height="300"
        x:Class="MusicPlusPlus.MessageWindow"
        Title="MessageWindow"
        WindowStartupLocation="CenterScreen"
        CanResize="False">
  
    <Grid
    ShowGridLines="False"
    ColumnDefinitions="25,*,*,*,*,25"
    RowDefinitions="75,25,*,*,50">
		
        <!--ЗАГОЛОВОК-->
        <WrapPanel
        Grid.ColumnSpan="6"
        Grid.Row="0"
        Background="{DynamicResource ResourceKey=SecondaryBackground}"
        Orientation="Horizontal">
			
            <!--лого-->
            <Image
            Source="/Resources/icon.png"
            VerticalAlignment="Center"
            Height="64"
            Width="64"
            Margin="0,5,0,0">
            </Image>

            <!--заголовок-->
            <TextBlock
            x:Name="TitleTBlock"
            Text="Заголовок"
            VerticalAlignment="Center"
            HorizontalAlignment="Left"
            Margin="0,10,0,0"
            FontSize="20">
            </TextBlock>

        </WrapPanel>

        <!--СООБЩЕНИЕ-->
        <TextBlock
        x:Name="WindowContentTBlock"
        Text="Сообщение"
        Grid.Column="1"
        Grid.ColumnSpan="4"
        Grid.Row="2"
        Grid.RowSpan="2"
        TextWrapping="Wrap">
        </TextBlock>

        <!--КНОПКА ОК-->
        <Button
        x:Name="OKB"
        Click="OKB_Click"
        Grid.Column="1"
        Grid.ColumnSpan="4"
        Grid.Row="4"
        VerticalAlignment="Center"
        HorizontalAlignment="Center"
        Width="50"
        Content="ОК"
        IsDefault="True">
        </Button>

    </Grid>

</Window>
